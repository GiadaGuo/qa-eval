    {
      "key": "inconsistent_record_count",
      "value_type": "NUMBER",
      "unit": "record",
      "minimum": 0,
      "direction": "LOWER_IS_BETTER"
    },
    {
      "key": "evaluable_record_count",
      "value_type": "NUMBER",
      "unit": "record",
      "minimum": 0,
      "direction": "NEUTRAL"
    },
    {
      "key": "coverage",
      "value_type": "NUMBER",
      "unit": "ratio",
      "minimum": 0,
      "maximum": 1,
      "direction": "HIGHER_IS_BETTER"
    },
    {
      "key": "all_input_consistent_ratio",
      "value_type": "NUMBER",
      "unit": "ratio",
      "minimum": 0,
      "maximum": 1,
      "direction": "HIGHER_IS_BETTER"
