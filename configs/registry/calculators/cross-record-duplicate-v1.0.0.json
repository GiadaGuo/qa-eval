                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "content_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "selector",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "selector": {
                  "const": "record_pointer"
                },
                "path": {
                  "type": "string",
                  "pattern": "^/(metadata|source|contents|annotations)/"
                },
                "value_type": {
                  "enum": [
                    "text",
                    "string",
                    "number",
                    "boolean",
                    "object",
                    "array",
                    "datetime"
                  ]
                }
              }
            }
          ]
        }
      },
      "strategies": {
        "type": "array",
        "items": {
          "enum": [
            "record_exact",
            "field_exact",
            "field_near"
          ]
        },
        "minItems": 1,
        "uniqueItems": true,
        "default": [
          "record_exact"
        ]
      },
      "near_threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "near_max_chars": {
        "type": "integer",
        "minimum": 5,
        "maximum": 100000,
        "default": 20000
      },
      "bucket_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128,
        "default": 32
      },
      "near_evidence_limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000,
        "default": 10000
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
  "deterministic": true,
  "capabilities": {
    "modalities": [
      "text"
    ],
    "scopes": [
