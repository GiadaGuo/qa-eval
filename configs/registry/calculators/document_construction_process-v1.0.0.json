      "artifact_kinds": [
        "DOCUMENT"
      ]
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/document_construction_process/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "Aspect": {
        "additionalProperties": false,
        "properties": {
          "item_code": {
            "minLength": 1,
            "title": "Item Code",
            "type": "string"
          },
          "item_name": {
            "minLength": 1,
            "title": "Item Name",
            "type": "string"
          },
          "satisfied_standard": {
            "minLength": 1,
            "title": "Satisfied Standard",
            "type": "string"
          },
          "counterexamples": {
            "items": {
              "type": "string"
            },
            "title": "Counterexamples",
            "type": "array"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
          },
          "applicable": {
            "default": true,
            "title": "Applicable",
            "type": "boolean"
          }
        },
        "required": [
          "item_code",
          "item_name",
          "satisfied_standard"
        ],
        "title": "Aspect",
        "type": "object"
      }
    },
    "properties": {
      "configuration": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Version",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/Aspect"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "version",
          "items"
        ],
        "title": "AspectConfiguration",
        "type": "object",
        "default": {
          "version": "1.0.0",
          "items": [
            {
              "item_code": "0103-01",
              "item_name": "数据来源",
              "satisfied_standard": "给出可识别的来源：来源系统、机构、库表、公开渠道或原始载体",
              "counterexamples": [
                "泛称「网络数据」「业务数据」而无具体来源"
              ],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0103-02",
              "item_name": "采集方式",
              "satisfied_standard": "说明数据如何获得——导出、爬取、API、上传或人工采集——以及相关的重要采集条件",
              "counterexamples": [
                "仅说明来源而不说明获取方式"
              ],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0103-03",
              "item_name": "加工流程",
              "satisfied_standard": "说明主要的清洗、转换、过滤、去重、保留或校验步骤；若确未做处理，明确声明数据原样保留及其边界也可满足",
              "counterexamples": [],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0103-04",
              "item_name": "标注规范",
              "satisfied_standard": "有标注数据：给出标签定义或操作规则及质量控制；确未标注数据：明确声明该事实并给出字段边界",
              "counterexamples": [],
              "notes": "evidence-assisted 模式下，证据显示存在标注时，「未标注」声明不满足本项",
              "applicable": true
            },
            {
              "item_code": "0103-05",
              "item_name": "版本记录",
              "satisfied_standard": "给出至少版本标识、时间与变更摘要；存在多版本且信息可得时，应说明版本间关系",
              "counterexamples": [
                "仅写「最新版本」"
              ],
              "notes": null,
              "applicable": true
            }
          ]
        }
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
  "deterministic": false,
  "capabilities": {
