{
  "schema_version": "1.0",
  "calculator_key": "policy_structure_compliance",
  "version": "1.1.0",
  "name": "政策结构完整性计算器",
  "entrypoint": "qa_eval.calculators.policy_structure_compliance_v3:LogicalPolicyStructureComplianceCalculator",
  "supported_metrics": [
    {
      "metric_key": "0204",
      "metric_version_range": ">=2.0.0,<3.0.0"
    }
  ],
  "input_contract": {
    "sample_record_schema": "3.0",
    "logical": {
      "version": "1.0",
      "grain": "RECORD",
      "mode": "DIRECT",
      "slots": [
        {
          "name": "title",
          "semantic": "document.title",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "html",
          "semantic": "document.body.html",
          "representation": "text/html",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "plain",
          "semantic": "document.body.plain",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "document_type",
          "semantic": "policy.document_type",
          "representation": "json",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "policyType",
          "semantic": "policy.policytype",
          "representation": "json",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "annotations",
          "semantic": "policy.annotations",
          "representation": "json",
          "value_type": "array",
          "required": false,
          "selectable": true
        }
      ],
      "artifact_kinds": []
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/policy-structure-compliance/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "html_role": {
        "type": "string",
        "minLength": 1,
        "default": "article.body.html"
      },
      "plain_role": {
        "type": "string",
        "minLength": 1,
        "default": "article.body.plain"
      },
      "title_role": {
        "type": "string",
        "minLength": 1,
        "default": "article.title"
      },
      "max_html_length_chars": {
        "type": "integer",
        "minimum": 1000,
        "default": 300000
      },
      "long_text_policy": {
        "type": "string",
        "enum": [
          "REJECT",
          "FULL_SCAN"
        ],
        "default": "REJECT"
      },
      "evidence_sample_limit": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
  "deterministic": true,
  "capabilities": {
    "modalities": [
      "text"
    ],
    "scopes": [
      "DATASET"
    ],
    "produces_evidence": true
  },
  "code_digest": "sha256:3303b6968849a6d9e00d999627527773f8e9a9acf95fd40542b66a6f844eeb78",
  "runtime": {
    "kind": "PYTHON_IN_PROCESS",
    "python_requires": ">=3.12",
    "dependencies": []
  },
  "input_artifact_requirements": [
    "RAW_RECORDS"
  ],
  "resource_profile": {
    "cost": "MEDIUM",
    "memory_mb": 512,
    "timeout_seconds": 3600
  },
  "applicability_constraints": {},
  "semantic_coverage": {
    "level": "PARTIAL",
    "covered": [
      "HTML/plain blocks",
      "legal/outline/generic/mixed structure",
      "numbering",
      "source HTML Unicode coordinates",
      "versioned ground truth"
    ],
    "excluded": [
      "attachment download/OCR",
      "legal semantic completeness"
    ]
  },
  "availability": {
    "status": "AVAILABLE",
    "reason": null
  },
  "sensitive_content_policy": {
    "access": "NORMALIZED_CONTENT",
    "emits_raw_content": false
  }
