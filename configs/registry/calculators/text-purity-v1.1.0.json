{
  "schema_version": "1.0",
  "calculator_key": "text_purity",
  "version": "1.1.0",
  "name": "文本纯净程度计算器",
  "entrypoint": "qa_eval.calculators.text_purity_v3:LogicalTextPurityCalculator",
  "supported_metrics": [
    {
      "metric_key": "02080106",
      "metric_version_range": ">=1.0.0,<2.0.0"
    },
    {
      "metric_key": "0208",
      "metric_version_range": "==2.0.0"
    }
  ],
  "input_contract": {
    "sample_record_schema": "3.0",
    "logical": {
      "version": "1.0",
      "grain": "RECORD",
      "mode": "DIRECT",
      "slots": [
        {
          "name": "body",
          "semantic": "document.body.plain",
          "representation": "text/plain",
          "value_type": "string"
        }
      ]
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/text-purity/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "content_role": {
        "type": "string",
        "minLength": 1,
        "default": "article.body.plain",
        "enum": [
          "article.body.plain"
        ]
      },
      "enabled_rules": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "GARBLED_UNPRINTABLE_CHARS",
            "REPETITIVE_SYMBOL_PILEUP",
            "HTML_MARKUP_RESIDUE",
            "LAYOUT_PAGE_RESIDUE",
            "EXPLICIT_ADVERTISING_MARKER"
          ]
        }
      },
      "garbled_char_ratio_threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.01
      },
      "symbol_run_length": {
        "type": "integer",
        "minimum": 2,
        "default": 6
      },
      "symbol_density_threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.05
      },
      "html_tag_count_threshold": {
        "type": "integer",
        "minimum": 1,
        "default": 3
      },
      "ad_marker_patterns": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "layout_residue_patterns": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
  "deterministic": true,
  "capabilities": {
    "modalities": [
      "text"
    ],
    "scopes": [
      "DATASET"
    ],
    "produces_evidence": true
  },
  "code_digest": "sha256:55697a1aea8a9d32e07ef6656459e321cb430b2eb6bc984029bdfaa86ff379cc",
  "runtime": {
    "kind": "PYTHON_IN_PROCESS",
    "python_requires": ">=3.12",
    "dependencies": []
  },
  "input_artifact_requirements": [
    "RAW_RECORDS"
  ],
  "resource_profile": {
    "cost": "LOW",
    "memory_mb": 256,
    "timeout_seconds": 300
  },
  "applicability_constraints": {},
  "semantic_coverage": {
    "level": "PARTIAL",
    "covered": [
      "显式干扰内容的确定性规则识别（乱码、特殊符号堆积、HTML 残留、页码/页眉页脚残留、显式广告标记）"
    ],
    "planned": [
      "隐性广告与软文的语义判断（由 Shared LLM Stage 补充后融合）"
    ],
    "excluded": [
      "语义性污染与上下文相关的排版噪声判定"
    ]
  },
  "availability": {
    "status": "AVAILABLE",
    "reason": null
  },
  "sensitive_content_policy": {
    "access": "NORMALIZED_CONTENT",
    "emits_raw_content": false
  }
}
