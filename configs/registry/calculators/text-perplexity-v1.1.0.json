  "code_digest": "sha256:7a9c3df6f31e4f4d71d351d2b47d5c785ca338c0e2379d89c487609efee65aaf",
  "runtime": {
    "kind": "PYTHON_IN_PROCESS",
    "python_requires": ">=3.12",
    "dependencies": [
      "kenlm"
    ]
  },
  "input_artifact_requirements": [
    "RAW_RECORDS",
    "KENLM_MODEL"
