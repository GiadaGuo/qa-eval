          "value_type": "string",
          "required": true,
          "selectable": true
        }
      ],
      "artifact_kinds": [
        "KENLM_MODEL"
      ]
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/text-perplexity/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "content_role": {
        "type": "string",
        "minLength": 1,
        "default": "article.body.plain"
      },
      "model_path": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "default": null
      },
      "tokenizer": {
        "type": "string",
        "enum": [
          "han_character",
          "whitespace"
        ],
        "default": "han_character"
      },
      "min_token_count": {
        "type": "integer",
        "minimum": 1,
        "default": 2
      },
      "high_perplexity_threshold": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 1000.0
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
  "deterministic": true,
  "capabilities": {
    "modalities": [
      "text"
    ],
    "scopes": [
      "DATASET"
    ],
    "produces_evidence": true
