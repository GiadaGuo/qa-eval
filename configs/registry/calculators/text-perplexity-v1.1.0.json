{
  "schema_version": "1.0",
  "calculator_key": "text_perplexity",
  "version": "1.1.0",
  "name": "文本困惑程度计算器",
  "entrypoint": "qa_eval.calculators.text_perplexity_v3:LogicalTextPerplexityCalculator",
  "supported_metrics": [
    {
      "metric_key": "02080101",
      "metric_version_range": ">=1.0.0,<2.0.0"
