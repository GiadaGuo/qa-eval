{
  "schema_version": "1.0",
  "calculator_key": "sensitive_dictionary_match",
  "version": "1.2.0",
  "name": "0202 敏感词典匹配",
  "entrypoint": "qa_eval.calculators.sensitive_dictionary_decision:SensitiveDictionaryDecisionCalculator",
  "supported_metrics": [
    {
      "metric_key": "0202",
      "metric_version_range": ">=2.0.0,<3.0.0"
    }
  ],
  "input_contract": {
    "sample_record_schema": "3.0",
    "logical": {
      "version": "1.0",
      "grain": "RECORD",
      "mode": "DIRECT",
      "slots": [
        {
          "name": "title",
          "semantic": "document.title",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "html",
          "semantic": "document.body.html",
          "representation": "text/html",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "plain",
          "semantic": "document.body.plain",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        }
      ],
      "artifact_kinds": []
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/sensitive-dictionary-match/1.2.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dictionary": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dictionary_id",
            "version",
            "category",
            "term",
            "enabled",
            "match_mode"
          ],
          "properties": {
            "dictionary_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "term": {
              "type": "string",
              "minLength": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "match_mode": {
              "const": "EXACT"
            },
            "term_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "dictionary_path": {
        "type": "string",
        "minLength": 1,
        "title": "敏感词典路径",
        "default": "configs/dictionaries/policy-sensitive-words-v1.0.0.json"
      },
      "case_sensitive": {
        "type": "boolean",
        "default": true
      },
      "unicode_normalization": {
        "enum": [
          "NONE",
          "NFC",
          "NFKC"
        ],
        "default": "NFKC"
      },
      "include_roles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "exclude_roles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "include_content_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "record_hit_threshold": {
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "title": "敏感词命中阈值（次）",
        "description": "单条记录汇总后达到该次数即判不合规。"
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/calculator-result/1.0.schema.json",
  "deterministic": true,
  "capabilities": {
    "modalities": [
      "text"
    ],
    "scopes": [
      "DATASET"
    ],
    "produces_evidence": true
  },
  "code_digest": "sha256:791b4f2059b275429e6df6b13f7db4df72b5476fda900f3924399515bf662cb7",
  "runtime": {
    "kind": "PYTHON_IN_PROCESS",
    "python_requires": ">=3.12",
    "dependencies": []
  },
  "input_artifact_requirements": [
    "RAW_RECORDS"
  ],
  "resource_profile": {
    "cost": "LOW",
    "memory_mb": 256,
    "timeout_seconds": 600
  },
  "applicability_constraints": {},
  "semantic_coverage": {
    "level": "PARTIAL",
    "covered": [
      "configured local EXACT dictionary entries"
    ],
    "excluded": [
      "semantic disambiguation and fuzzy variants"
    ]
  },
  "availability": {
    "status": "AVAILABLE",
    "reason": null
  },
  "sensitive_content_policy": {
    "access": "NORMALIZED_CONTENT",
    "emits_raw_content": false
  },
  "execution": {
    "mode": "DIRECT"
  },
  "native_output": {
    "schema_version": "1.0",
    "statistics": [
      {
        "key": "input_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "去重后的输入样本。"
      },
      {
        "key": "compliant_record_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "标签 1",
        "partition_of": "input_count"
      },
      {
        "key": "non_compliant_record_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "标签 0",
        "partition_of": "input_count"
      },
      {
        "key": "not_evaluated_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "未判定",
        "partition_of": "input_count"
      },
      {
        "key": "evaluable_record_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "标签 1 或 0"
      },
      {
        "key": "evaluable_rate",
        "kind": "ratio",
        "unit": "ratio",
        "population": "INPUT",
        "method": "分母为零时为空。",
        "numerator_key": "evaluable_record_count",
        "denominator_key": "input_count",
        "minimum": 0,
        "maximum": 1
      },
      {
        "key": "evaluated_compliance_ratio",
        "kind": "ratio",
        "unit": "ratio",
        "population": "INPUT",
        "method": "分母为零时为空。",
        "numerator_key": "compliant_record_count",
        "denominator_key": "evaluable_record_count",
        "minimum": 0,
        "maximum": 1
      },
      {
        "key": "compliant_record_ratio",
        "kind": "ratio",
        "unit": "ratio",
        "population": "INPUT",
        "method": "分母为零时为空。",
        "numerator_key": "compliant_record_count",
        "denominator_key": "input_count",
        "minimum": 0,
        "maximum": 1
      },
      {
        "key": "unknown_reasons",
        "kind": "distribution",
        "unit": "count",
        "population": "INPUT",
        "method": "按规则和记录原因计数。"
      },
      {
        "key": "sensitive_entity_hit_count",
        "kind": "count",
        "unit": "entity",
        "population": "可评测记录中的不同命中位置",
        "method": "跨字段合并后按非重叠位置计数"
      },
      {
        "key": "sensitive_entity_type_counts",
        "kind": "distribution",
        "unit": "entity",
        "population": "可评测记录中的不同命中位置",
        "method": "跨字段合并后按非重叠位置计数"
      }
    ],
    "decision_retention": "ALL",
    "decision_population_key": "input_count"
  }
}
