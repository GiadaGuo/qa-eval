{
  "schema_version": "1.0",
  "calculator_key": "document_content_characteristics",
  "version": "1.0.0",
  "name": "内容特征完整性检测",
  "entrypoint": "qa_eval.calculators.document_completeness:ContentCharacteristicsCalculator",
  "supported_metrics": [
    {
      "metric_key": "0102",
      "metric_version_range": "==1.0.0"
    }
  ],
  "input_contract": {
    "sample_record_schema": "DOCUMENT",
    "role_selectors": [],
    "logical": {
      "version": "1.0",
      "grain": "DOCUMENT",
      "mode": "DIRECT",
      "artifact_kinds": [
        "DOCUMENT"
      ]
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/document_content_characteristics/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "Aspect": {
        "additionalProperties": false,
        "properties": {
          "item_code": {
            "minLength": 1,
            "title": "Item Code",
            "type": "string"
          },
          "item_name": {
            "minLength": 1,
            "title": "Item Name",
            "type": "string"
          },
          "satisfied_standard": {
            "minLength": 1,
            "title": "Satisfied Standard",
            "type": "string"
          },
          "counterexamples": {
            "items": {
              "type": "string"
            },
            "title": "Counterexamples",
            "type": "array"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
          },
          "applicable": {
            "default": true,
            "title": "Applicable",
            "type": "boolean"
          }
        },
        "required": [
          "item_code",
          "item_name",
          "satisfied_standard"
        ],
        "title": "Aspect",
        "type": "object"
      }
    },
    "properties": {
      "configuration": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Version",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/Aspect"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "version",
          "items"
        ],
        "title": "AspectConfiguration",
        "type": "object",
        "default": {
          "version": "1.0.0",
          "items": [
            {
              "item_code": "0102-01",
              "item_name": "模态",
              "satisfied_standard": "明确指出模态——文本、图像、音频、视频或多模态——并描述主要内容形态",
              "counterexamples": [],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0102-02",
              "item_name": "数据分布",
              "satisfied_standard": "给出至少一个有意义的分布及其统计口径（如按长度、标签、语言、时间或来源），含数量或占比",
              "counterexamples": [
                "仅给出总量一个数字"
              ],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0102-03",
              "item_name": "标签类别统计",
              "satisfied_standard": "有标注数据：给出标签类别及数量或占比；确无标注数据：明确给出无标注的数量/占比，并有 schema 或证据支撑",
              "counterexamples": [
                "仅写「没有标签」，无量化亦无支撑"
              ],
              "notes": "无标签声明需要量化与支撑才可满足，如无标注占比及其字段依据",
              "applicable": true
            },
            {
              "item_code": "0102-04",
              "item_name": "样例",
              "satisfied_standard": "给出至少一个能展示真实 schema 或内容形态的代表性样例",
              "counterexamples": [
                "仅给出占位伪代码或字段名"
              ],
              "notes": "不得要求披露不必要的敏感内容",
              "applicable": true
            },
            {
              "item_code": "0102-05",
              "item_name": "局限性",
              "satisfied_standard": "给出至少一个具体的覆盖缺口、偏差、质量风险、代表性约束或使用限制",
              "counterexamples": [
                "仅写「可能存在局限性」"
              ],
              "notes": null,
              "applicable": true
            }
          ]
        }
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
  "deterministic": false,
  "capabilities": {
    "modalities": [
      "text",
      "image",
      "audio",
      "video",
      "structured"
    ],
    "scopes": [
      "DATASET"
    ],
    "produces_evidence": true
  },
  "code_digest": "sha256:10b83f375844a86a8ff0dbb199a1efed9183b009a97b5ecaa5911c3358dc53ee",
  "runtime": {
    "kind": "PYTHON_IN_PROCESS",
    "python_requires": ">=3.12",
    "dependencies": []
  },
  "resource_profile": {
    "cost": "LOW",
    "memory_mb": 128,
    "timeout_seconds": 60
  },
  "availability": {
    "status": "AVAILABLE",
    "reason": null
  }
}
