{
  "schema_version": "1.0",
  "calculator_key": "policy_effectiveness",
  "version": "1.1.0",
  "name": "政策效力证据观察",
  "entrypoint": "qa_eval.calculators.policy_effectiveness_v3:LogicalPolicyEffectivenessCalculator",
  "supported_metrics": [
    {
      "metric_key": "0205",
      "metric_version_range": "==1.0.0"
    }
  ],
  "input_contract": {
    "sample_record_schema": "3.0",
    "logical": {
      "version": "1.0",
      "grain": "RECORD",
      "mode": "DIRECT",
      "slots": [
        {
          "name": "title",
          "semantic": "document.title",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "html",
          "semantic": "document.body.html",
          "representation": "text/html",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "plain",
          "semantic": "document.body.plain",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "document_type",
          "semantic": "policy.document_type",
          "representation": "json",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "formatted_at",
          "semantic": "policy.formatted_at",
          "representation": "json",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "published_at",
          "semantic": "policy.published_at",
          "representation": "json",
          "value_type": "string",
          "required": false,
          "selectable": true
        }
      ],
      "artifact_kinds": [
        "DATASET_MANIFEST"
      ]
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/policy-effectiveness/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference_date": {
        "type": "string",
        "format": "date",
        "description": "默认运行创建时的上海日期。"
      },
      "observation_date": {
        "type": "string",
        "format": "date",
        "description": "已核实的文书状态观察日期，默认使用快照采集日。"
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/calculator-result/1.0.schema.json",
  "deterministic": true,
  "capabilities": {
    "modalities": [
      "text"
    ],
    "scopes": [
      "DATASET"
    ],
    "produces_evidence": true
  },
  "code_digest": "sha256:c9115e9e71bb72ad9bc971ddb193f6747c94bed89e5d519b8ad6452f8ede5820",
  "input_artifact_requirements": [
    "RAW_RECORDS",
    "DATASET_MANIFEST"
  ],
  "applicability_constraints": {},
  "native_output": {
    "schema_version": "1.0",
    "statistics": [
      {
        "key": "input_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "按已发布 SampleRecord.sample_id 计数。"
      },
      {
        "key": "applicable_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "适用性为 APPLICABLE。",
        "partition_of": "input_count"
      },
      {
        "key": "not_applicable_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "适用性为 NOT_APPLICABLE。",
        "partition_of": "input_count"
      },
      {
        "key": "applicability_unknown_count",
        "kind": "count",
        "unit": "record",
        "population": "INPUT",
        "method": "适用性为 APPLICABILITY_UNCERTAIN。",
        "partition_of": "input_count"
      },
      {
        "key": "expired_evidenced_count",
        "kind": "count",
        "unit": "record",
        "population": "APPLICABLE",
        "method": "效力证据为 EXPIRED_EVIDENCED。",
        "partition_of": "applicable_count"
      },
      {
        "key": "not_expired_by_known_term_count",
        "kind": "count",
        "unit": "record",
        "population": "APPLICABLE",
        "method": "仅表示已知期限未届满。",
        "partition_of": "applicable_count"
      },
      {
        "key": "undetermined_count",
        "kind": "count",
        "unit": "record",
        "population": "APPLICABLE",
        "method": "效力证据为 UNDETERMINED。",
        "partition_of": "applicable_count"
      },
      {
        "key": "decidable_count",
        "kind": "count",
        "unit": "record",
        "population": "APPLICABLE",
        "method": "失效有证据数加已知期限未届满数。"
      },
      {
        "key": "decidable_coverage",
        "kind": "ratio",
        "unit": "ratio",
        "population": "APPLICABLE",
        "method": "可判定数除以适用样本数。分母为零时为空。",
        "minimum": 0,
        "maximum": 1,
        "numerator_key": "decidable_count",
        "denominator_key": "applicable_count"
      },
      {
        "key": "expired_evidence_rate",
        "kind": "ratio",
        "unit": "ratio",
        "population": "APPLICABLE",
        "method": "失效有证据数除以适用样本数。分母包含未判定，分母为零时为空。",
        "minimum": 0,
        "maximum": 1,
        "numerator_key": "expired_evidenced_count",
        "denominator_key": "applicable_count"
      }
    ],
    "decision_retention": "ALL",
    "decision_population_key": "input_count"
  }
}
