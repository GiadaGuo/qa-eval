      "artifact_kinds": [
        "DOCUMENT"
      ]
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/document_application_instructions/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "Aspect": {
        "additionalProperties": false,
        "properties": {
          "item_code": {
            "minLength": 1,
            "title": "Item Code",
            "type": "string"
          },
          "item_name": {
            "minLength": 1,
            "title": "Item Name",
            "type": "string"
          },
          "satisfied_standard": {
            "minLength": 1,
            "title": "Satisfied Standard",
            "type": "string"
          },
          "counterexamples": {
            "items": {
              "type": "string"
            },
            "title": "Counterexamples",
            "type": "array"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
          },
          "applicable": {
            "default": true,
            "title": "Applicable",
            "type": "boolean"
          }
        },
        "required": [
          "item_code",
          "item_name",
          "satisfied_standard"
        ],
        "title": "Aspect",
        "type": "object"
      }
    },
    "properties": {
      "configuration": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Version",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/Aspect"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "version",
          "items"
        ],
        "title": "AspectConfiguration",
        "type": "object",
        "default": {
          "version": "1.0.0",
          "items": [
            {
              "item_code": "0104-01",
              "item_name": "使用许可",
              "satisfied_standard": "给出具名许可或授权依据；或给出覆盖适用部门/用户、允许用途、再分发与重大限制的具体授权范围",
              "counterexamples": [
                "未说明适用部门与范围的「仅限内部使用」"
              ],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0104-02",
              "item_name": "目标应用场景",
              "satisfied_standard": "给出具体任务、目标用户或业务用途",
              "counterexamples": [
                "仅写「用于 AI」「用于研究」"
              ],
              "notes": "明确禁用或高风险用途可增强判定，但非必需",
              "applicable": true
            },
            {
              "item_code": "0104-03",
              "item_name": "评估方法",
              "satisfied_standard": "说明评估对象、计算或验证方式、所需输入或度量口径",
              "counterexamples": [
                "仅写「进行质量评估」"
              ],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0104-04",
              "item_name": "基准结果",
              "satisfied_standard": "给出任务、适用时的被测方法或模型、指标与实测结果",
              "counterexamples": [
                "仅写「未测试」",
                "只有计划而无结果的评测方案",
                "把数据质量统计误标为下游模型性能"
              ],
              "notes": null,
              "applicable": true
            },
            {
              "item_code": "0104-05",
              "item_name": "典型应用案例",
              "satisfied_standard": "给出具体用例，含输入与处理方式或预期产出/价值",
              "counterexamples": [
                "仅给出场景名称"
              ],
              "notes": "拟议中的案例须明确标注为拟议，不得伪装成已投产记录",
              "applicable": true
            }
          ]
        }
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
