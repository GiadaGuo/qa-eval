{
  "schema_version": "1.0",
  "calculator_key": "sensitive_dictionary_match",
  "version": "1.1.0",
  "name": "0202 敏感词典匹配",
  "entrypoint": "qa_eval.calculators.policy_sensitive_logical:LogicalSensitiveDictionaryMatchCalculator",
  "supported_metrics": [
    {
      "metric_key": "0202",
      "metric_version_range": ">=2.0.0,<3.0.0"
    }
  ],
  "input_contract": {
    "sample_record_schema": "3.0",
    "logical": {
      "version": "1.0",
      "grain": "RECORD",
      "mode": "DIRECT",
      "slots": [
        {
          "name": "title",
          "semantic": "document.title",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "html",
          "semantic": "document.body.html",
          "representation": "text/html",
          "value_type": "string",
          "required": false,
          "selectable": true
        },
        {
          "name": "plain",
          "semantic": "document.body.plain",
          "representation": "text/plain",
          "value_type": "string",
          "required": false,
          "selectable": true
        }
      ],
      "artifact_kinds": []
    }
  },
  "parameter_schema_ref": "qa-eval://schemas/calculators/sensitive-dictionary-match/1.0.0/parameters",
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dictionary": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dictionary_id",
            "version",
            "category",
            "term",
            "enabled",
            "match_mode"
          ],
          "properties": {
            "dictionary_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "term": {
              "type": "string",
              "minLength": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "match_mode": {
              "const": "EXACT"
            },
            "term_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "dictionary_path": {
        "type": "string",
        "minLength": 1,
        "title": "敏感词典路径",
        "default": "configs/dictionaries/policy-sensitive-words-v1.0.0.json"
      },
      "case_sensitive": {
        "type": "boolean",
        "default": true
      },
      "unicode_normalization": {
        "enum": [
          "NONE",
          "NFC",
          "NFKC"
        ],
        "default": "NFKC"
      },
      "include_roles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "exclude_roles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "include_content_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "output_schema_ref": "qa-eval://schemas/metric-result/1.0.schema.json",
  "deterministic": true,
  "capabilities": {
    "modalities": [
      "text"
    ],
    "scopes": [
      "DATASET"
    ],
    "produces_evidence": true
  },
  "code_digest": "sha256:af8452f53d0f74e8300c90a689eec81c74c19a385810768df3222f9fc6adb201",
  "runtime": {
    "kind": "PYTHON_IN_PROCESS",
    "python_requires": ">=3.12",
    "dependencies": []
  },
  "input_artifact_requirements": [
    "RAW_RECORDS"
  ],
  "resource_profile": {
    "cost": "LOW",
    "memory_mb": 256,
    "timeout_seconds": 600
  },
  "applicability_constraints": {},
  "semantic_coverage": {
    "level": "PARTIAL",
    "covered": [
      "configured local EXACT dictionary entries"
    ],
    "excluded": [
      "semantic disambiguation and fuzzy variants"
    ]
  },
  "availability": {
    "status": "AVAILABLE",
    "reason": null
  },
  "sensitive_content_policy": {
    "access": "NORMALIZED_CONTENT",
    "emits_raw_content": false
  },
  "execution": {
    "mode": "DIRECT"
  }
}
