{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-eval://schemas/evidence/intra_record_repetition/1.0.0",
  "title": "Intra-record repetition evidence JSONL row",
  "type": "object",
  "required": ["row_id", "sample_id", "locations", "redundant_chars", "effective_chars", "score", "verdict", "coordinates"],
  "properties": {
    "row_id": {"type": "string"},
    "sample_id": {"type": "string"},
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "ranges"],
        "properties": {
          "field": {"type": "object"},
          "ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "integer", "minimum": 0}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "redundant_chars": {"type": "integer", "minimum": 0},
    "effective_chars": {"type": "integer", "minimum": 1},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "verdict": {"enum": [0, 1, "NOT_EVALUATED"]},
    "coordinates": {"type": "string"}
  },
  "additionalProperties": false
}
