{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "checksum": {
          "$ref": "#/$defs/Checksum"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "enum": [
            "RAW_DATA",
            "DATASET_MANIFEST",
            "NORMALIZED_DATA",
            "REJECTED_RECORDS",
            "PROFILE",
            "STAGE_OUTPUT",
            "METRIC_EVIDENCE",
            "ISSUE_INDEX",
            "REPORT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        },
        "schema_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Ref"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "format",
        "media_type",
        "size_bytes",
        "checksum"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "redaction": {
          "$ref": "#/$defs/EvidenceRedaction"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "subject_scope": {
          "enum": [
            "DATASET",
            "SAMPLE",
            "CONTENT",
            "ANNOTATION"
          ],
          "title": "Subject Scope",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/EvidenceSummary"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "schema_ref",
        "artifact",
        "subject_scope",
        "summary",
        "redaction"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "EvidenceRedaction": {
      "additionalProperties": false,
      "properties": {
        "contains_raw_content": {
          "title": "Contains Raw Content",
          "type": "boolean"
        },
        "policy": {
          "minLength": 1,
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "contains_raw_content",
        "policy"
      ],
      "title": "EvidenceRedaction",
      "type": "object"
    },
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        }
      },
      "required": [
        "record_count"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "title": "Value"
        },
        "value_type": {
          "enum": [
            "NUMBER",
            "STRING",
            "BOOLEAN",
            "OBJECT"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "value_type"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "MetricPopulation": {
      "additionalProperties": false,
      "properties": {
        "evaluated_count": {
          "minimum": 0,
          "title": "Evaluated Count",
          "type": "integer"
        },
        "excluded_count": {
          "minimum": 0,
          "title": "Excluded Count",
          "type": "integer"
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/PopulationExclusion"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "input_count": {
          "minimum": 0,
          "title": "Input Count",
          "type": "integer"
        }
      },
      "required": [
        "input_count",
        "evaluated_count",
        "excluded_count"
      ],
      "title": "MetricPopulation",
      "type": "object"
    },
    "MetricSubject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "DATASET",
            "SAMPLE",
            "CONTENT",
            "ANNOTATION"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "id"
      ],
      "title": "MetricSubject",
      "type": "object"
    },
    "PopulationExclusion": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "count"
      ],
      "title": "PopulationExclusion",
      "type": "object"
    },
    "SemanticCoverage": {
      "additionalProperties": false,
      "properties": {
        "covered": {
          "items": {
            "type": "string"
          },
          "title": "Covered",
          "type": "array"
        },
        "excluded": {
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "level": {
          "enum": [
            "FULL",
            "PARTIAL"
          ],
          "title": "Level",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "level"
      ],
      "title": "SemanticCoverage",
      "type": "object"
    },
    "VersionedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "VersionedKey",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/metric-result/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "title": "Evidence",
      "type": "array"
    },
    "metric": {
      "$ref": "#/$defs/VersionedKey"
    },
    "metric_result_id": {
      "format": "uuid",
      "title": "Metric Result Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/MetricObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "population": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricPopulation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stage_run_id": {
      "format": "uuid",
      "title": "Stage Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "NOT_APPLICABLE",
        "MISSING",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/MetricSubject"
    }
  },
  "required": [
    "metric_result_id",
    "run_id",
    "stage_run_id",
    "dataset_version_id",
    "metric",
    "subject",
    "status",
    "created_at"
  ],
  "title": "MetricResultV1",
  "type": "object"
}
