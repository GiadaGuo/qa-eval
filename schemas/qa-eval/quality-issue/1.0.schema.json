{
  "$defs": {
    "AnnotationIssueSubject": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "minLength": 1,
          "title": "Annotation Id",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "type": {
          "const": "ANNOTATION",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sample_id",
        "annotation_id"
      ],
      "title": "AnnotationIssueSubject",
      "type": "object"
    },
    "ContentIssueSubject": {
      "additionalProperties": false,
      "properties": {
        "content_id": {
          "minLength": 1,
          "title": "Content Id",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "type": {
          "const": "CONTENT",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sample_id",
        "content_id"
      ],
      "title": "ContentIssueSubject",
      "type": "object"
    },
    "DatasetIssueSubject": {
      "additionalProperties": false,
      "properties": {
        "dataset_version_id": {
          "format": "uuid",
          "title": "Dataset Version Id",
          "type": "string"
        },
        "type": {
          "const": "DATASET",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "dataset_version_id"
      ],
      "title": "DatasetIssueSubject",
      "type": "object"
    },
    "GroupIssueSubject": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "member_count": {
          "minimum": 1,
          "title": "Member Count",
          "type": "integer"
        },
        "type": {
          "const": "GROUP",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "group_id",
        "member_count"
      ],
      "title": "GroupIssueSubject",
      "type": "object"
    },
    "IssueEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": true,
          "title": "Locator",
          "type": "object"
        }
      },
      "required": [
        "evidence_id",
        "locator"
      ],
      "title": "IssueEvidenceRef",
      "type": "object"
    },
    "IssueSource": {
      "additionalProperties": false,
      "properties": {
        "measurement": {
          "minLength": 1,
          "title": "Measurement",
          "type": "string"
        },
        "metric_key": {
          "minLength": 1,
          "title": "Metric Key",
          "type": "string"
        },
        "metric_result_id": {
          "format": "uuid",
          "title": "Metric Result Id",
          "type": "string"
        },
        "metric_version": {
          "minLength": 1,
          "title": "Metric Version",
          "type": "string"
        },
        "rule_evaluation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Evaluation Id"
        }
      },
      "required": [
        "metric_result_id",
        "metric_key",
        "metric_version",
        "measurement"
      ],
      "title": "IssueSource",
      "type": "object"
    },
    "PairIssueSubject": {
      "additionalProperties": false,
      "properties": {
        "left_sample_id": {
          "minLength": 1,
          "title": "Left Sample Id",
          "type": "string"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "right_sample_id": {
          "minLength": 1,
          "title": "Right Sample Id",
          "type": "string"
        },
        "type": {
          "const": "PAIR",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "pair_id",
        "left_sample_id",
        "right_sample_id"
      ],
      "title": "PairIssueSubject",
      "type": "object"
    },
    "RelatedIssueSubject": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "subject": {
          "discriminator": {
            "mapping": {
              "ANNOTATION": "#/$defs/AnnotationIssueSubject",
              "CONTENT": "#/$defs/ContentIssueSubject",
              "DATASET": "#/$defs/DatasetIssueSubject",
              "GROUP": "#/$defs/GroupIssueSubject",
              "PAIR": "#/$defs/PairIssueSubject",
              "SAMPLE": "#/$defs/SampleIssueSubject"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DatasetIssueSubject"
            },
            {
              "$ref": "#/$defs/GroupIssueSubject"
            },
            {
              "$ref": "#/$defs/SampleIssueSubject"
            },
            {
              "$ref": "#/$defs/PairIssueSubject"
            },
            {
              "$ref": "#/$defs/ContentIssueSubject"
            },
            {
              "$ref": "#/$defs/AnnotationIssueSubject"
            }
          ],
          "title": "Subject"
        }
      },
      "required": [
        "relation",
        "subject"
      ],
      "title": "RelatedIssueSubject",
      "type": "object"
    },
    "SampleIssueSubject": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "type": {
          "const": "SAMPLE",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sample_id"
      ],
      "title": "SampleIssueSubject",
      "type": "object"
    },
    "VersionedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "VersionedKey",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/quality-issue/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "category": {
      "minLength": 1,
      "title": "Category",
      "type": "string"
    },
    "code": {
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "dedup_key": {
      "minLength": 1,
      "title": "Dedup Key",
      "type": "string"
    },
    "detector": {
      "$ref": "#/$defs/VersionedKey"
    },
    "determination": {
      "enum": [
        "CONFIRMED",
        "CANDIDATE"
      ],
      "title": "Determination",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/IssueEvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "issue_id": {
      "format": "uuid",
      "title": "Issue Id",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "related_subjects": {
      "items": {
        "$ref": "#/$defs/RelatedIssueSubject"
      },
      "title": "Related Subjects",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "DATASET",
        "GROUP",
        "SAMPLE",
        "PAIR",
        "CONTENT",
        "ANNOTATION"
      ],
      "title": "Scope",
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/IssueSource"
    },
    "status": {
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "RESOLVED",
        "DISMISSED"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject": {
      "discriminator": {
        "mapping": {
          "ANNOTATION": "#/$defs/AnnotationIssueSubject",
          "CONTENT": "#/$defs/ContentIssueSubject",
          "DATASET": "#/$defs/DatasetIssueSubject",
          "GROUP": "#/$defs/GroupIssueSubject",
          "PAIR": "#/$defs/PairIssueSubject",
          "SAMPLE": "#/$defs/SampleIssueSubject"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DatasetIssueSubject"
        },
        {
          "$ref": "#/$defs/GroupIssueSubject"
        },
        {
          "$ref": "#/$defs/SampleIssueSubject"
        },
        {
          "$ref": "#/$defs/PairIssueSubject"
        },
        {
          "$ref": "#/$defs/ContentIssueSubject"
        },
        {
          "$ref": "#/$defs/AnnotationIssueSubject"
        }
      ],
      "title": "Subject"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "issue_id",
    "run_id",
    "dataset_version_id",
    "source",
    "detector",
    "category",
    "code",
    "determination",
    "severity",
    "scope",
    "subject",
    "message",
    "evidence",
    "dedup_key",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "QualityIssueV1",
  "type": "object"
}
