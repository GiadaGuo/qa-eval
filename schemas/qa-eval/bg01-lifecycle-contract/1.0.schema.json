{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-eval://schemas/bg01-lifecycle-contract/1.0",
  "title": "BG-01 version association and lifecycle contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_key", "version", "entities", "snapshot_binding"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_key": {"const": "bg01-lifecycle-contract"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entities": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "identity", "lifecycle", "mutation_policy"],
        "properties": {
          "name": {"enum": ["DatasetVersion", "ObservedProfileVersion", "DatasetCardRevision", "ProfileSnapshot"]},
          "identity": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "lifecycle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "mutation_policy": {"type": "string", "minLength": 1}
        }
      }
    },
    "snapshot_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_version", "observed_profile", "dataset_card", "manifest", "rules", "immutability"],
      "properties": {
        "dataset_version": {"const": "EXACT_ID_AND_CONTENT_FINGERPRINT"},
        "observed_profile": {"const": "EXACT_PROFILE_ID_AND_CHECKSUM"},
        "dataset_card": {"const": "EXACT_REVISION_AND_CONTENT_SHA256_OR_NULL"},
        "manifest": {"const": "EXACT_URI_AND_SHA256"},
        "rules": {"const": "EXACT_KEY_VERSION_AND_SHA256"},
        "immutability": {"const": "CONTENT_ADDRESSED_APPEND_ONLY"}
      }
    }
  }
}
