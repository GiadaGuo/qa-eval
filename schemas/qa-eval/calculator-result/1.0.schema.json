{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "checksum": {
          "$ref": "#/$defs/Checksum"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "enum": [
            "RAW_DATA",
            "DATASET_MANIFEST",
            "NORMALIZED_DATA",
            "REJECTED_RECORDS",
            "PROFILE",
            "PROFILE_SNAPSHOT",
            "DATASET_CARD_MARKDOWN",
            "CARD_COMPARISON_DETAILS",
            "STAGE_OUTPUT",
            "METRIC_EVIDENCE",
            "ISSUE_INDEX",
            "REPORT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        },
        "schema_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Ref"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "format",
        "media_type",
        "size_bytes",
        "checksum"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CalculatorOutputSchemaV1": {
      "additionalProperties": false,
      "properties": {
        "decision_population_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Population Key"
        },
        "decision_retention": {
          "default": "NONE",
          "enum": [
            "NONE",
            "ALL",
            "EXCEPTIONS",
            "SAMPLE"
          ],
          "title": "Decision Retention",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "statistics": {
          "items": {
            "$ref": "#/$defs/StatisticDefinition"
          },
          "minItems": 1,
          "title": "Statistics",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "statistics"
      ],
      "title": "CalculatorOutputSchemaV1",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "redaction": {
          "$ref": "#/$defs/EvidenceRedaction"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "subject_scope": {
          "enum": [
            "DATASET",
            "SAMPLE",
            "CONTENT",
            "ANNOTATION",
            "DOCUMENT"
          ],
          "title": "Subject Scope",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/EvidenceSummary"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "schema_ref",
        "artifact",
        "subject_scope",
        "summary",
        "redaction"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "EvidenceRedaction": {
      "additionalProperties": false,
      "properties": {
        "contains_raw_content": {
          "title": "Contains Raw Content",
          "type": "boolean"
        },
        "policy": {
          "minLength": 1,
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "contains_raw_content",
        "policy"
      ],
      "title": "EvidenceRedaction",
      "type": "object"
    },
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        }
      },
      "required": [
        "record_count"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "StatisticDefinition": {
      "additionalProperties": false,
      "properties": {
        "denominator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Key"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "scalar",
            "distribution",
            "object"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "numerator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Key"
        },
        "partition_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Of"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "unit",
        "population",
        "method"
      ],
      "title": "StatisticDefinition",
      "type": "object"
    },
    "VersionedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "VersionedKey",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/calculator-result/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "dataset_version_id": {
          "type": "string"
        },
        "document_version_id": {
          "type": "null"
        }
      },
      "required": [
        "dataset_version_id"
      ]
    },
    {
      "properties": {
        "dataset_version_id": {
          "type": "null"
        },
        "document_version_id": {
          "type": "string"
        }
      },
      "required": [
        "document_version_id"
      ]
    }
  ],
  "properties": {
    "calculator_key": {
      "title": "Calculator Key",
      "type": "string"
    },
    "calculator_result_id": {
      "format": "uuid",
      "title": "Calculator Result Id",
      "type": "string"
    },
    "calculator_version": {
      "title": "Calculator Version",
      "type": "string"
    },
    "contract_item_key": {
      "title": "Contract Item Key",
      "type": "string"
    },
    "dataset_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Version Id"
    },
    "decision_artifact_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "title": "Decision Artifact Refs",
      "type": "array"
    },
    "document_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Version Id"
    },
    "evidence_artifact_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "title": "Evidence Artifact Refs",
      "type": "array"
    },
    "input_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "metric": {
      "$ref": "#/$defs/VersionedKey"
    },
    "output_schema": {
      "$ref": "#/$defs/CalculatorOutputSchemaV1"
    },
    "output_slot_id": {
      "title": "Output Slot Id",
      "type": "string"
    },
    "plan_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_run_id": {
      "format": "uuid",
      "title": "Stage Run Id",
      "type": "string"
    },
    "statistics": {
      "additionalProperties": true,
      "title": "Statistics",
      "type": "object"
    },
    "status": {
      "enum": [
        "OK",
        "PARTIAL",
        "NOT_APPLICABLE",
        "MISSING",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_detail": {
      "additionalProperties": true,
      "title": "Status Detail",
      "type": "object"
    }
  },
  "required": [
    "calculator_result_id",
    "run_id",
    "stage_run_id",
    "contract_item_key",
    "output_slot_id",
    "metric",
    "calculator_key",
    "calculator_version",
    "input_fingerprint",
    "plan_fingerprint",
    "status",
    "output_schema"
  ],
  "title": "CalculatorResultV1",
  "type": "object"
}
