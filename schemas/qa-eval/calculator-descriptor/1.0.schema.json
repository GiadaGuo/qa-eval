{
  "$defs": {
    "CalculatorAvailability": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "default": "AVAILABLE",
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "DEPRECATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "CalculatorAvailability",
      "type": "object"
    },
    "CalculatorCapabilities": {
      "additionalProperties": false,
      "properties": {
        "modalities": {
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "structured"
            ],
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "produces_evidence": {
          "title": "Produces Evidence",
          "type": "boolean"
        },
        "scopes": {
          "items": {
            "enum": [
              "DATASET",
              "SAMPLE",
              "CONTENT",
              "ANNOTATION"
            ],
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "modalities",
        "scopes",
        "produces_evidence"
      ],
      "title": "CalculatorCapabilities",
      "type": "object"
    },
    "CalculatorOutputSchemaV1": {
      "additionalProperties": false,
      "properties": {
        "decision_population_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Population Key"
        },
        "decision_retention": {
          "default": "NONE",
          "enum": [
            "NONE",
            "ALL",
            "EXCEPTIONS",
            "SAMPLE"
          ],
          "title": "Decision Retention",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "statistics": {
          "items": {
            "$ref": "#/$defs/StatisticDefinition"
          },
          "minItems": 1,
          "title": "Statistics",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "statistics"
      ],
      "title": "CalculatorOutputSchemaV1",
      "type": "object"
    },
    "CalculatorResourceProfile": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "default": "LOW",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Cost",
          "type": "string"
        },
        "memory_mb": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "timeout_seconds": {
          "default": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "CalculatorResourceProfile",
      "type": "object"
    },
    "CalculatorRuntime": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "kind": {
          "const": "PYTHON_IN_PROCESS",
          "default": "PYTHON_IN_PROCESS",
          "title": "Kind",
          "type": "string"
        },
        "python_requires": {
          "default": ">=3.12",
          "minLength": 1,
          "title": "Python Requires",
          "type": "string"
        }
      },
      "title": "CalculatorRuntime",
      "type": "object"
    },
    "InferenceExecutionCapability": {
      "additionalProperties": false,
      "description": "Execution metadata for calculators that score shared model output.",
      "properties": {
        "aggregation_strategy": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Strategy"
        },
        "input_roles": {
          "items": {
            "$ref": "#/$defs/InferenceInputRole"
          },
          "title": "Input Roles",
          "type": "array"
        },
        "mode": {
          "default": "DIRECT",
          "enum": [
            "DIRECT",
            "SHARED_INFERENCE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "operator_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator Type"
        },
        "output_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Field"
        },
        "prompt_family": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Family"
        },
        "prompt_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "required_static_context": {
          "items": {
            "type": "string"
          },
          "title": "Required Static Context",
          "type": "array"
        },
        "rubric": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric"
        },
        "rubric_output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Output Schema"
        },
        "rubric_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Version"
        },
        "shareability_constraints": {
          "additionalProperties": true,
          "title": "Shareability Constraints",
          "type": "object"
        },
        "static_context": {
          "additionalProperties": true,
          "title": "Static Context",
          "type": "object"
        }
      },
      "title": "InferenceExecutionCapability",
      "type": "object"
    },
    "InferenceInputRole": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "role"
      ],
      "title": "InferenceInputRole",
      "type": "object"
    },
    "InputSlot": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "default": "one",
          "enum": [
            "one",
            "many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "non_empty": {
          "default": false,
          "title": "Non Empty",
          "type": "boolean"
        },
        "representation": {
          "enum": [
            "json",
            "text/plain",
            "text/html"
          ],
          "title": "Representation",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "selectable": {
          "default": false,
          "title": "Selectable",
          "type": "boolean"
        },
        "semantic": {
          "minLength": 1,
          "title": "Semantic",
          "type": "string"
        },
        "value_type": {
          "default": "any",
          "enum": [
            "string",
            "object",
            "array",
            "number",
            "boolean",
            "any"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "semantic",
        "representation"
      ],
      "title": "InputSlot",
      "type": "object"
    },
    "SensitiveContentPolicy": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "default": "NORMALIZED_CONTENT",
          "enum": [
            "NONE",
            "NORMALIZED_CONTENT",
            "RAW_CONTENT"
          ],
          "title": "Access",
          "type": "string"
        },
        "emits_raw_content": {
          "default": false,
          "title": "Emits Raw Content",
          "type": "boolean"
        }
      },
      "title": "SensitiveContentPolicy",
      "type": "object"
    },
    "StatisticDefinition": {
      "additionalProperties": false,
      "properties": {
        "denominator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Key"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "scalar",
            "distribution",
            "object"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "numerator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Key"
        },
        "partition_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Of"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "unit",
        "population",
        "method"
      ],
      "title": "StatisticDefinition",
      "type": "object"
    },
    "SupportedMetric": {
      "additionalProperties": false,
      "properties": {
        "metric_key": {
          "minLength": 1,
          "title": "Metric Key",
          "type": "string"
        },
        "metric_version_range": {
          "minLength": 1,
          "title": "Metric Version Range",
          "type": "string"
        }
      },
      "required": [
        "metric_key",
        "metric_version_range"
      ],
      "title": "SupportedMetric",
      "type": "object"
    },
    "qa_eval__contracts__logical_inputs__CalculatorInputContract": {
      "additionalProperties": false,
      "properties": {
        "artifact_kinds": {
          "default": [],
          "items": {
            "enum": [
              "PROFILE_SNAPSHOT",
              "DATASET_MANIFEST",
              "DOCUMENT",
              "KENLM_MODEL"
            ],
            "type": "string"
          },
          "title": "Artifact Kinds",
          "type": "array"
        },
        "grain": {
          "enum": [
            "RECORD",
            "DATASET",
            "DOCUMENT"
          ],
          "title": "Grain",
          "type": "string"
        },
        "mode": {
          "enum": [
            "DIRECT",
            "SHARED_INFERENCE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "slots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InputSlot"
          },
          "title": "Slots",
          "type": "array"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "grain",
        "mode"
      ],
      "title": "CalculatorInputContract",
      "type": "object"
    },
    "qa_eval__contracts__registry__CalculatorInputContract": {
      "additionalProperties": false,
      "properties": {
        "logical": {
          "anyOf": [
            {
              "$ref": "#/$defs/qa_eval__contracts__logical_inputs__CalculatorInputContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role_selectors": {
          "items": {
            "type": "string"
          },
          "title": "Role Selectors",
          "type": "array"
        },
        "sample_record_schema": {
          "minLength": 1,
          "title": "Sample Record Schema",
          "type": "string"
        }
      },
      "required": [
        "sample_record_schema"
      ],
      "title": "CalculatorInputContract",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/calculator-descriptor/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability_constraints": {
      "additionalProperties": true,
      "title": "Applicability Constraints",
      "type": "object"
    },
    "availability": {
      "$ref": "#/$defs/CalculatorAvailability"
    },
    "calculator_key": {
      "minLength": 1,
      "title": "Calculator Key",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/CalculatorCapabilities"
    },
    "code_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Digest"
    },
    "deterministic": {
      "title": "Deterministic",
      "type": "boolean"
    },
    "entrypoint": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entrypoint"
    },
    "execution": {
      "$ref": "#/$defs/InferenceExecutionCapability"
    },
    "input_artifact_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Input Artifact Requirements",
      "type": "array"
    },
    "input_contract": {
      "$ref": "#/$defs/qa_eval__contracts__registry__CalculatorInputContract"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "native_output": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalculatorOutputSchemaV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_schema_ref": {
      "minLength": 1,
      "title": "Output Schema Ref",
      "type": "string"
    },
    "parameter_schema": {
      "additionalProperties": true,
      "title": "Parameter Schema",
      "type": "object"
    },
    "parameter_schema_ref": {
      "minLength": 1,
      "title": "Parameter Schema Ref",
      "type": "string"
    },
    "resource_profile": {
      "$ref": "#/$defs/CalculatorResourceProfile"
    },
    "runtime": {
      "$ref": "#/$defs/CalculatorRuntime"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_coverage": {
      "additionalProperties": true,
      "title": "Semantic Coverage",
      "type": "object"
    },
    "sensitive_content_policy": {
      "$ref": "#/$defs/SensitiveContentPolicy"
    },
    "supported_metrics": {
      "items": {
        "$ref": "#/$defs/SupportedMetric"
      },
      "minItems": 1,
      "title": "Supported Metrics",
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "calculator_key",
    "version",
    "name",
    "supported_metrics",
    "input_contract",
    "parameter_schema_ref",
    "parameter_schema",
    "output_schema_ref",
    "deterministic",
    "capabilities"
  ],
  "title": "CalculatorDescriptorV1",
  "type": "object"
}
