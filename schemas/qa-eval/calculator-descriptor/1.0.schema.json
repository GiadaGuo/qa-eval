{
  "$defs": {
    "CalculatorAvailability": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "default": "AVAILABLE",
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "DEPRECATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "CalculatorAvailability",
      "type": "object"
    },
    "CalculatorCapabilities": {
      "additionalProperties": false,
      "properties": {
        "modalities": {
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "structured"
            ],
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "produces_evidence": {
          "title": "Produces Evidence",
          "type": "boolean"
        },
        "scopes": {
          "items": {
            "enum": [
              "DATASET",
              "SAMPLE",
              "CONTENT",
              "ANNOTATION"
            ],
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "modalities",
        "scopes",
        "produces_evidence"
      ],
      "title": "CalculatorCapabilities",
      "type": "object"
    },
    "CalculatorInputContract": {
      "additionalProperties": false,
      "properties": {
        "role_selectors": {
          "items": {
            "type": "string"
          },
          "title": "Role Selectors",
          "type": "array"
        },
        "sample_record_schema": {
          "minLength": 1,
          "title": "Sample Record Schema",
          "type": "string"
        }
      },
      "required": [
        "sample_record_schema"
      ],
      "title": "CalculatorInputContract",
      "type": "object"
    },
    "CalculatorResourceProfile": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "default": "LOW",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Cost",
          "type": "string"
        },
        "memory_mb": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "timeout_seconds": {
          "default": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "CalculatorResourceProfile",
      "type": "object"
    },
    "CalculatorRuntime": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "kind": {
          "const": "PYTHON_IN_PROCESS",
          "default": "PYTHON_IN_PROCESS",
          "title": "Kind",
          "type": "string"
        },
        "python_requires": {
          "default": ">=3.12",
          "minLength": 1,
          "title": "Python Requires",
          "type": "string"
        }
      },
      "title": "CalculatorRuntime",
      "type": "object"
    },
    "InferenceExecutionCapability": {
      "additionalProperties": false,
      "description": "Execution metadata for calculators that score shared model output.",
      "properties": {
        "aggregation_strategy": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Strategy"
        },
        "mode": {
          "default": "DIRECT",
          "enum": [
            "DIRECT",
            "SHARED_INFERENCE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "operator_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator Type"
        },
        "output_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Field"
        },
        "prompt_family": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Family"
        },
        "rubric": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric"
        },
        "shareability_constraints": {
          "additionalProperties": true,
          "title": "Shareability Constraints",
          "type": "object"
        }
      },
      "title": "InferenceExecutionCapability",
      "type": "object"
    },
    "SensitiveContentPolicy": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "default": "NORMALIZED_CONTENT",
          "enum": [
            "NONE",
            "NORMALIZED_CONTENT",
            "RAW_CONTENT"
          ],
          "title": "Access",
          "type": "string"
        },
        "emits_raw_content": {
          "default": false,
          "title": "Emits Raw Content",
          "type": "boolean"
        }
      },
      "title": "SensitiveContentPolicy",
      "type": "object"
    },
    "SupportedMetric": {
      "additionalProperties": false,
      "properties": {
        "metric_key": {
          "minLength": 1,
          "title": "Metric Key",
          "type": "string"
        },
        "metric_version_range": {
          "minLength": 1,
          "title": "Metric Version Range",
          "type": "string"
        }
      },
      "required": [
        "metric_key",
        "metric_version_range"
      ],
      "title": "SupportedMetric",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/calculator-descriptor/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability_constraints": {
      "additionalProperties": true,
      "title": "Applicability Constraints",
      "type": "object"
    },
    "availability": {
      "$ref": "#/$defs/CalculatorAvailability"
    },
    "calculator_key": {
      "minLength": 1,
      "title": "Calculator Key",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/CalculatorCapabilities"
    },
    "code_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Digest"
    },
    "deterministic": {
      "title": "Deterministic",
      "type": "boolean"
    },
    "entrypoint": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entrypoint"
    },
    "execution": {
      "$ref": "#/$defs/InferenceExecutionCapability"
    },
    "input_artifact_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Input Artifact Requirements",
      "type": "array"
    },
    "input_contract": {
      "$ref": "#/$defs/CalculatorInputContract"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "output_schema_ref": {
      "minLength": 1,
      "title": "Output Schema Ref",
      "type": "string"
    },
    "parameter_schema": {
      "additionalProperties": true,
      "title": "Parameter Schema",
      "type": "object"
    },
    "parameter_schema_ref": {
      "minLength": 1,
      "title": "Parameter Schema Ref",
      "type": "string"
    },
    "resource_profile": {
      "$ref": "#/$defs/CalculatorResourceProfile"
    },
    "runtime": {
      "$ref": "#/$defs/CalculatorRuntime"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_coverage": {
      "additionalProperties": true,
      "title": "Semantic Coverage",
      "type": "object"
    },
    "sensitive_content_policy": {
      "$ref": "#/$defs/SensitiveContentPolicy"
    },
    "supported_metrics": {
      "items": {
        "$ref": "#/$defs/SupportedMetric"
      },
      "minItems": 1,
      "title": "Supported Metrics",
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "calculator_key",
    "version",
    "name",
    "supported_metrics",
    "input_contract",
    "parameter_schema_ref",
    "parameter_schema",
    "output_schema_ref",
    "deterministic",
    "capabilities"
  ],
  "title": "CalculatorDescriptorV1",
  "type": "object"
}
