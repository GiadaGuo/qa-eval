{
  "$defs": {
    "PhysicalStageV1": {
      "additionalProperties": false,
      "properties": {
        "calculator": {
          "additionalProperties": true,
          "title": "Calculator",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "input_schema_ref": {
          "minLength": 1,
          "title": "Input Schema Ref",
          "type": "string"
        },
        "logical_operation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Logical Operation Ids",
          "type": "array"
        },
        "metric": {
          "$ref": "#/$defs/VersionedKey"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "output_bindings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Output Bindings",
          "type": "array"
        },
        "output_schema_ref": {
          "minLength": 1,
          "title": "Output Schema Ref",
          "type": "string"
        },
        "resolved_parameters": {
          "additionalProperties": true,
          "title": "Resolved Parameters",
          "type": "object"
        },
        "shared_computation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shared Computation Id"
        },
        "stage_id": {
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "stage_kind": {
          "default": "DIRECT",
          "enum": [
            "DIRECT",
            "SHARED_INFERENCE"
          ],
          "title": "Stage Kind",
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "order",
        "metric",
        "calculator",
        "resolved_parameters",
        "input_schema_ref",
        "output_schema_ref"
      ],
      "title": "PhysicalStageV1",
      "type": "object"
    },
    "VersionedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "VersionedKey",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/physical-evaluation-plan/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version_id": {
      "format": "uuid",
      "title": "Contract Version Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "executor_type": {
      "const": "LOCAL",
      "default": "LOCAL",
      "title": "Executor Type",
      "type": "string"
    },
    "logical_plan_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logical Plan Id"
    },
    "physical_plan_id": {
      "format": "uuid",
      "title": "Physical Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Semantic Fingerprint",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/PhysicalStageV1"
      },
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "physical_plan_id",
    "dataset_version_id",
    "contract_version_id",
    "stages",
    "semantic_fingerprint",
    "created_at"
  ],
  "title": "PhysicalEvaluationPlanV1",
  "type": "object"
}
