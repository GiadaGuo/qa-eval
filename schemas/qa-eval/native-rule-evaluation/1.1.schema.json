{
  "$defs": {
    "EvaluatedRule": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                "LT",
                "LTE",
                "GT",
                "GTE",
                "EQ",
                "NE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "strategy": {
          "default": "THRESHOLD",
          "enum": [
            "THRESHOLD",
            "OBSERVE_ONLY"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "title": "EvaluatedRule",
      "type": "object"
    },
    "NativeStatisticRef": {
      "additionalProperties": false,
      "properties": {
        "calculator_version": {
          "minLength": 1,
          "title": "Calculator Version",
          "type": "string"
        },
        "contract_item_key": {
          "minLength": 1,
          "title": "Contract Item Key",
          "type": "string"
        },
        "output_slot_id": {
          "minLength": 1,
          "title": "Output Slot Id",
          "type": "string"
        },
        "statistics_key": {
          "minLength": 1,
          "title": "Statistics Key",
          "type": "string"
        }
      },
      "required": [
        "contract_item_key",
        "output_slot_id",
        "calculator_version",
        "statistics_key"
      ],
      "title": "NativeStatisticRef",
      "type": "object"
    },
    "StatisticDefinition": {
      "additionalProperties": false,
      "properties": {
        "denominator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Key"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "scalar",
            "distribution",
            "object"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "numerator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Key"
        },
        "partition_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Of"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "unit",
        "population",
        "method"
      ],
      "title": "StatisticDefinition",
      "type": "object"
    },
    "VersionedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "VersionedKey",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/native-rule-evaluation/1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calculator": {
      "$ref": "#/$defs/VersionedKey"
    },
    "calculator_result_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Calculator Result Id"
    },
    "contract_version_id": {
      "format": "uuid",
      "title": "Contract Version Id",
      "type": "string"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "denominator": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Denominator"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "metric": {
      "$ref": "#/$defs/VersionedKey"
    },
    "metric_value": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Value"
    },
    "numerator": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Numerator"
    },
    "reason_code": {
      "title": "Reason Code",
      "type": "string"
    },
    "rule": {
      "$ref": "#/$defs/EvaluatedRule"
    },
    "rule_evaluation_id": {
      "format": "uuid",
      "title": "Rule Evaluation Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "statistic": {
      "$ref": "#/$defs/StatisticDefinition"
    },
    "statistic_ref": {
      "$ref": "#/$defs/NativeStatisticRef"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUATED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "rule_evaluation_id",
    "run_id",
    "dataset_version_id",
    "contract_version_id",
    "calculator_result_id",
    "calculator",
    "metric",
    "statistic_ref",
    "statistic",
    "severity",
    "rule",
    "status",
    "reason_code",
    "evaluated_at"
  ],
  "title": "NativeRuleEvaluationV1",
  "type": "object"
}
