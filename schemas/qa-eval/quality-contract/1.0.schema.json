{
  "$defs": {
    "ContractApplicability": {
      "additionalProperties": false,
      "properties": {
        "modalities": {
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "structured"
            ],
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "task_types": {
          "items": {
            "type": "string"
          },
          "title": "Task Types",
          "type": "array"
        }
      },
      "title": "ContractApplicability",
      "type": "object"
    },
    "ContractCalculation": {
      "additionalProperties": false,
      "properties": {
        "implementation_constraints": {
          "$ref": "#/$defs/ImplementationConstraints"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "title": "ContractCalculation",
      "type": "object"
    },
    "ContractGate": {
      "additionalProperties": false,
      "properties": {
        "fail_on_severities": {
          "items": {
            "enum": [
              "INFO",
              "WARNING",
              "ERROR",
              "CRITICAL"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Fail On Severities",
          "type": "array"
        },
        "unknown_policy": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Unknown Policy",
          "type": "string"
        }
      },
      "required": [
        "unknown_policy",
        "fail_on_severities"
      ],
      "title": "ContractGate",
      "type": "object"
    },
    "ContractMetricSelector": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "measurement": {
          "minLength": 1,
          "title": "Measurement",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version",
        "measurement"
      ],
      "title": "ContractMetricSelector",
      "type": "object"
    },
    "FrozenCoveragePolicy": {
      "additionalProperties": false,
      "properties": {
        "coverage_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Min",
          "type": "number"
        },
        "source": {
          "enum": [
            "SYSTEM_DEFAULT",
            "CONTRACT_SLOT"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "coverage_min",
        "source"
      ],
      "title": "FrozenCoveragePolicy",
      "type": "object"
    },
    "FrozenDocumentTarget": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "threshold": {
          "maximum": 100,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "document_version_id",
        "sha256",
        "uri",
        "filename",
        "weights",
        "threshold"
      ],
      "title": "FrozenDocumentTarget",
      "type": "object"
    },
    "ImplementationConstraints": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "deterministic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deterministic"
        }
      },
      "title": "ImplementationConstraints",
      "type": "object"
    },
    "NativeEvaluationItemV1": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "$ref": "#/$defs/ContractCalculation"
        },
        "coverage_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrozenCoveragePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/VersionedKey"
        },
        "output_schema_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Schema Fingerprint",
          "type": "string"
        },
        "output_schema_version": {
          "const": "1.0",
          "title": "Output Schema Version",
          "type": "string"
        },
        "projections": {
          "items": {
            "$ref": "#/$defs/VersionedKey"
          },
          "maxItems": 0,
          "title": "Projections",
          "type": "array"
        },
        "rule": {
          "$ref": "#/$defs/ThresholdRule"
        },
        "schema_version": {
          "const": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "DATASET",
          "title": "Scope",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "statistic": {
          "$ref": "#/$defs/StatisticDefinition"
        },
        "statistic_ref": {
          "$ref": "#/$defs/NativeStatisticRef"
        },
        "strategy": {
          "const": "EVALUATE",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "key",
        "metric",
        "scope",
        "calculation",
        "strategy",
        "projections",
        "statistic_ref",
        "rule",
        "severity",
        "statistic",
        "output_schema_version",
        "output_schema_fingerprint"
      ],
      "title": "NativeEvaluationItemV1",
      "type": "object"
    },
    "NativeObservationItemV1": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "$ref": "#/$defs/ContractCalculation"
        },
        "coverage_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrozenCoveragePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/VersionedKey"
        },
        "projections": {
          "items": {
            "$ref": "#/$defs/VersionedKey"
          },
          "maxItems": 0,
          "title": "Projections",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "DATASET",
          "title": "Scope",
          "type": "string"
        },
        "strategy": {
          "const": "OBSERVE_ONLY",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "key",
        "metric",
        "scope",
        "calculation",
        "strategy",
        "projections"
      ],
      "title": "NativeObservationItemV1",
      "type": "object"
    },
    "NativeStatisticRef": {
      "additionalProperties": false,
      "properties": {
        "calculator_version": {
          "minLength": 1,
          "title": "Calculator Version",
          "type": "string"
        },
        "contract_item_key": {
          "minLength": 1,
          "title": "Contract Item Key",
          "type": "string"
        },
        "output_slot_id": {
          "minLength": 1,
          "title": "Output Slot Id",
          "type": "string"
        },
        "statistics_key": {
          "minLength": 1,
          "title": "Statistics Key",
          "type": "string"
        }
      },
      "required": [
        "contract_item_key",
        "output_slot_id",
        "calculator_version",
        "statistics_key"
      ],
      "title": "NativeStatisticRef",
      "type": "object"
    },
    "QualityContractItem": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "$ref": "#/$defs/ContractCalculation"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/ContractMetricSelector"
        },
        "on_missing": {
          "enum": [
            "UNKNOWN",
            "SKIPPED"
          ],
          "title": "On Missing",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/ThresholdRule"
        },
        "scope": {
          "enum": [
            "DATASET",
            "SAMPLE",
            "CONTENT",
            "ANNOTATION",
            "DOCUMENT"
          ],
          "title": "Scope",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "key",
        "metric",
        "scope",
        "rule",
        "severity",
        "on_missing"
      ],
      "title": "QualityContractItem",
      "type": "object"
    },
    "ScoreRange": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "ScoreRange",
      "type": "object"
    },
    "ScoringProfileMetric": {
      "additionalProperties": false,
      "properties": {
        "aggregation_method": {
          "enum": [
            "DIRECT",
            "WEIGHTED_MEAN"
          ],
          "title": "Aggregation Method",
          "type": "string"
        },
        "dimension_id": {
          "pattern": "^(020[1-8]|010[1-4])$",
          "title": "Dimension Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "HIGHER_IS_BETTER",
            "LOWER_IS_BETTER",
            "UNSCORED"
          ],
          "title": "Direction",
          "type": "string"
        },
        "eligibility_policy": {
          "enum": [
            "FULL_RESULT",
            "SAMPLED_ESTIMATE",
            "OBSERVE_ONLY",
            "NOT_APPLICABLE"
          ],
          "title": "Eligibility Policy",
          "type": "string"
        },
        "measurement_key": {
          "minLength": 1,
          "title": "Measurement Key",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Version"
        },
        "scoring_mapping_version": {
          "minLength": 1,
          "title": "Scoring Mapping Version",
          "type": "string"
        },
        "scoring_method": {
          "enum": [
            "RATIO_HIGHER_IS_BETTER",
            "RATIO_LOWER_IS_BETTER",
            "NONE"
          ],
          "title": "Scoring Method",
          "type": "string"
        },
        "valid_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "weight_source": {
          "anyOf": [
            {
              "enum": [
                "USER",
                "APPROVED",
                "EQUAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Source"
        }
      },
      "required": [
        "metric_id",
        "measurement_key",
        "scoring_mapping_version",
        "scoring_method",
        "direction",
        "weight",
        "dimension_id",
        "eligibility_policy",
        "aggregation_method"
      ],
      "title": "ScoringProfileMetric",
      "type": "object"
    },
    "ScoringProfileV1": {
      "additionalProperties": false,
      "properties": {
        "aggregation_method": {
          "const": "WEIGHTED_MEAN",
          "title": "Aggregation Method",
          "type": "string"
        },
        "disclaimer": {
          "minLength": 1,
          "title": "Disclaimer",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/ScoringProfileMetric"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_type": {
          "enum": [
            "MVP_OPERATIONAL",
            "OFFICIAL_GUIDE",
            "BUSINESS"
          ],
          "title": "Profile Type",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "profile_type",
        "aggregation_method",
        "metrics",
        "disclaimer"
      ],
      "title": "ScoringProfileV1",
      "type": "object"
    },
    "StatisticDefinition": {
      "additionalProperties": false,
      "properties": {
        "denominator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Key"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "scalar",
            "distribution",
            "object"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "numerator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Key"
        },
        "partition_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Of"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "unit",
        "population",
        "method"
      ],
      "title": "StatisticDefinition",
      "type": "object"
    },
    "ThresholdRule": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "anyOf": [
            {
              "enum": [
                "LT",
                "LTE",
                "GT",
                "GTE",
                "EQ",
                "NE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "strategy": {
          "default": "THRESHOLD",
          "enum": [
            "THRESHOLD",
            "OBSERVE_ONLY"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "threshold": {
          "default": null,
          "title": "Threshold"
        }
      },
      "title": "ThresholdRule",
      "type": "object"
    },
    "VersionedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "VersionedKey",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/quality-contract/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "$ref": "#/$defs/ContractApplicability"
    },
    "contract_id": {
      "format": "uuid",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_version_id": {
      "format": "uuid",
      "title": "Contract Version Id",
      "type": "string"
    },
    "document_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrozenDocumentTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "excluded_metrics": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excluded Metrics"
    },
    "fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "gate": {
      "$ref": "#/$defs/ContractGate"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/QualityContractItem"
      },
      "title": "Items",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "observation_items": {
      "items": {
        "discriminator": {
          "mapping": {
            "EVALUATE": "#/$defs/NativeEvaluationItemV1",
            "OBSERVE_ONLY": "#/$defs/NativeObservationItemV1"
          },
          "propertyName": "strategy"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NativeObservationItemV1"
          },
          {
            "$ref": "#/$defs/NativeEvaluationItemV1"
          }
        ]
      },
      "title": "Observation Items",
      "type": "array"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScoringProfileV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "RETIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "version_label": {
      "minLength": 1,
      "title": "Version Label",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "contract_version_id",
    "version_label",
    "name",
    "status",
    "applicability",
    "items",
    "gate",
    "fingerprint"
  ],
  "title": "QualityContractVersionV1",
  "type": "object"
}
