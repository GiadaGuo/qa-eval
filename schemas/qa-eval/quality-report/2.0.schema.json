      "title": "Business Gate Results",
      "type": "array"
    },
    "contract_fingerprint": {
      "title": "Contract Fingerprint",
      "type": "string"
    },
    "contract_version_id": {
      "format": "uuid",
      "title": "Contract Version Id",
      "type": "string"
    },
    "coverage_gates": {
      "additionalProperties": {
        "$ref": "#/$defs/ReportCoverage"
