        },
        "satisfied_aspect_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Satisfied Aspect Count"
        },
        "score": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "stage_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Run Id"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "key",
        "status",
        "weight",
        "base_weight",
        "coverage",
        "reasons"
      ],
      "title": "ReportMetric",
      "type": "object"
    },
    "ReportSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "contract_version_id": {
          "format": "uuid",
          "title": "Contract Version Id",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        }
