{
  "$defs": {
    "BusinessGate": {
      "additionalProperties": false,
      "properties": {
        "approval_ref": {
          "title": "Approval Ref",
          "type": "string"
        },
        "rule_evaluation_id": {
          "format": "uuid",
          "title": "Rule Evaluation Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "INDETERMINATE"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "approval_ref",
        "rule_evaluation_id",
        "verdict"
      ],
      "title": "BusinessGate",
      "type": "object"
    },
    "DocumentMapping": {
      "additionalProperties": false,
      "properties": {
        "approved_na": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Approved Na",
          "type": "object"
        },
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "evaluator_version": {
          "title": "Evaluator Version",
          "type": "string"
        },
        "observations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Observations",
          "type": "object"
        },
        "report_fingerprint": {
          "title": "Report Fingerprint",
          "type": "string"
        },
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "rubric_sha256": {
          "title": "Rubric Sha256",
          "type": "string"
        },
        "rubric_version": {
          "title": "Rubric Version",
          "type": "string"
        },
        "version": {
          "const": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "report_id",
        "document_version_id",
        "dataset_id",
        "report_fingerprint",
        "rubric_version",
        "rubric_sha256",
        "evaluator_version",
        "observations"
      ],
      "title": "DocumentMapping",
      "type": "object"
    },
    "ReportCoverage": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "INDETERMINATE",
            "NA"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict"
      ],
      "title": "ReportCoverage",
      "type": "object"
    },
    "ReportDimension": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/ReportMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "threshold": {
          "default": 90,
          "maximum": 100,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "INDETERMINATE"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "key",
        "score",
        "status",
        "verdict",
        "metrics",
        "reasons"
      ],
      "title": "ReportDimension",
      "type": "object"
    },
    "ReportMetric": {
      "additionalProperties": false,
      "properties": {
        "base_weight": {
          "title": "Base Weight",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Checks",
          "type": "array"
        },
        "coverage": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Coverage",
          "type": "object"
        },
        "evidence_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Paths",
          "type": "array"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "ref": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "required_aspect_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
