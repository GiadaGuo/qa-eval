      "type": "object"
    },
    "dataset_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportSnapshotRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dataset_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Version Id"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/ReportDimension"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "document_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentMapping"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "document_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportSnapshotRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "document_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Version Id"
    },
    "finalized_at": {
      "title": "Finalized At",
      "type": "string"
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "gate_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Gate Reasons",
      "type": "array"
    },
    "input_fingerprint": {
      "title": "Input Fingerprint",
      "type": "string"
    },
    "issue_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Issue Counts",
      "type": "object"
    },
    "mode": {
      "default": "BASIC",
      "enum": [
        "BASIC",
        "DOCUMENT"
      ],
      "title": "Mode",
      "type": "string"
    },
    "overall_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INDETERMINATE"
      ],
      "title": "Overall Verdict",
      "type": "string"
    },
    "plan_fingerprint": {
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_profile": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scoring Profile"
    }
