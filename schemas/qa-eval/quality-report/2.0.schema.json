  "$id": "qa-eval://schemas/quality-report/2.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "dataset_version_id": {
          "type": "string"
        },
        "document_version_id": {
          "type": "null"
        }
      },
      "required": [
        "dataset_version_id"
      ]
    },
    {
      "properties": {
        "dataset_version_id": {
          "type": "null"
        },
        "document_version_id": {
          "type": "string"
        }
      },
      "required": [
        "document_version_id"
      ]
    }
