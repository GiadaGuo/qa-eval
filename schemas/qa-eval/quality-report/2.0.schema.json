  "required": [
    "report_id",
    "run_id",
    "contract_version_id",
    "contract_fingerprint",
    "plan_fingerprint",
    "input_fingerprint",
    "fingerprint",
    "finalized_at",
    "dimensions",
    "overall_verdict",
    "gate_reasons",
    "issue_counts"
