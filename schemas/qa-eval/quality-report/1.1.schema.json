          "type": "object"
        },
        "included_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Included Metrics",
          "type": "array"
        },
        "overall_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall Score"
        },
        "overall_score_status": {
          "default": "UNAVAILABLE",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE"
          ],
          "title": "Overall Score Status",
          "type": "string"
        },
        "partial_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Score"
        },
        "policy": {
          "default": "EXPLICIT_GUIDE_WEIGHT_AND_MAPPING_V2",
          "title": "Policy",
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoringProfileV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_weight": {
          "default": 0,
          "minimum": 0,
          "title": "Raw Weight",
          "type": "number"
        },
        "scored_weight": {
          "default": 0,
          "minimum": 0,
          "title": "Scored Weight",
          "type": "number"
        },
        "unscored_weight": {
          "default": 0,
          "minimum": 0,
          "title": "Unscored Weight",
          "type": "number"
        }
      },
      "required": [
        "effective_coverage",
        "disclaimer"
      ],
      "title": "ReportScoring",
      "type": "object"
    },
    "ReportTraceabilitySummary": {
      "additionalProperties": false,
      "description": "Business-facing counts and completeness for one metric result.",
      "properties": {
        "affected_record_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Record Count"
        },
        "detected_fact_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detected Fact Count"
        },
        "evidence_completeness": {
          "default": "UNKNOWN",
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNKNOWN"
          ],
          "title": "Evidence Completeness",
          "type": "string"
        },
        "issue_detail_completeness": {
          "default": "UNKNOWN",
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNKNOWN"
          ],
          "title": "Issue Detail Completeness",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "materialized_issue_count": {
          "default": 0,
          "minimum": 0,
          "title": "Materialized Issue Count",
          "type": "integer"
        },
        "persisted_evidence_record_count": {
          "default": 0,
          "minimum": 0,
          "title": "Persisted Evidence Record Count",
          "type": "integer"
        }
      },
      "title": "ReportTraceabilitySummary",
      "type": "object"
    },
    "ScoreRange": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "ScoreRange",
      "type": "object"
    },
    "ScoringProfileMetric": {
      "additionalProperties": false,
      "properties": {
        "aggregation_method": {
          "enum": [
            "DIRECT",
            "WEIGHTED_MEAN"
          ],
          "title": "Aggregation Method",
          "type": "string"
        },
        "dimension_id": {
          "pattern": "^(020[1-8]|010[1-4])$",
          "title": "Dimension Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "HIGHER_IS_BETTER",
            "LOWER_IS_BETTER",
            "UNSCORED"
          ],
          "title": "Direction",
          "type": "string"
        },
        "eligibility_policy": {
          "enum": [
            "FULL_RESULT",
            "SAMPLED_ESTIMATE",
            "OBSERVE_ONLY",
            "NOT_APPLICABLE"
          ],
          "title": "Eligibility Policy",
          "type": "string"
        },
        "measurement_key": {
          "minLength": 1,
          "title": "Measurement Key",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Version"
        },
        "scoring_mapping_version": {
          "minLength": 1,
          "title": "Scoring Mapping Version",
          "type": "string"
        },
        "scoring_method": {
          "enum": [
            "RATIO_HIGHER_IS_BETTER",
            "RATIO_LOWER_IS_BETTER",
            "NONE"
          ],
          "title": "Scoring Method",
          "type": "string"
        },
        "valid_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "weight_source": {
          "anyOf": [
            {
              "enum": [
                "USER",
                "APPROVED",
                "EQUAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Source"
        }
      },
      "required": [
        "metric_id",
        "measurement_key",
        "scoring_mapping_version",
        "scoring_method",
        "direction",
        "weight",
        "dimension_id",
        "eligibility_policy",
        "aggregation_method"
      ],
      "title": "ScoringProfileMetric",
      "type": "object"
    },
    "ScoringProfileV1": {
      "additionalProperties": false,
      "properties": {
        "aggregation_method": {
          "const": "WEIGHTED_MEAN",
          "title": "Aggregation Method",
          "type": "string"
        },
        "disclaimer": {
          "minLength": 1,
          "title": "Disclaimer",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/ScoringProfileMetric"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_type": {
          "enum": [
            "MVP_OPERATIONAL",
            "OFFICIAL_GUIDE",
            "BUSINESS"
          ],
          "title": "Profile Type",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "profile_type",
        "aggregation_method",
        "metrics",
        "disclaimer"
      ],
      "title": "ScoringProfileV1",
      "type": "object"
    },
    "StatisticDefinition": {
      "additionalProperties": false,
      "properties": {
        "denominator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Key"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "scalar",
            "distribution",
            "object"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "numerator_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Key"
        },
        "partition_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition Of"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "unit",
        "population",
        "method"
      ],
      "title": "StatisticDefinition",
      "type": "object"
    },
    "VersionedKey": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "VersionedKey",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/quality-report/1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Comprehensive presentation contract with explicit score scope.",
  "properties": {
    "contract_version_id": {
      "format": "uuid",
      "title": "Contract Version Id",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/ReportCoverage"
    },
    "coverage_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportCoverageAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "dimension_scores": {
      "items": {
        "$ref": "#/$defs/ReportDimensionScore"
      },
      "title": "Dimension Scores",
      "type": "array"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/ReportDimension"
      },
      "minItems": 1,
      "title": "Dimensions",
      "type": "array"
    },
    "execution_status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "PARTIAL_SUCCEEDED",
        "FAILED",
        "CANCELED"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "gate_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Gate Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/VersionedKey"
    },
    "guide_coverage": {
      "items": {
        "$ref": "#/$defs/ReportGuideCoverageItem"
      },
      "title": "Guide Coverage",
      "type": "array"
    },
    "issue_summary": {
      "$ref": "#/$defs/ReportIssueSummary"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/ReportMetricSection"
      },
      "title": "Metrics",
      "type": "array"
    },
    "native_evaluations": {
      "items": {
        "$ref": "#/$defs/NativeEvaluationReportSection"
      },
      "title": "Native Evaluations",
      "type": "array"
    },
    "radar": {
      "items": {
        "$ref": "#/$defs/ReportRadarAxis"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Radar",
      "type": "array"
    },
    "recommendation_details": {
      "items": {
        "$ref": "#/$defs/ReportRecommendation"
      },
      "title": "Recommendation Details",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "rendered_artifact_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Rendered Artifact Ids",
      "type": "array"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring": {
      "$ref": "#/$defs/ReportScoring"
    },
    "task_type": {
      "anyOf": [
        {
          "enum": [
            "DATASET",
            "SINGLE_METRIC",
            "DOCUMENT"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Type"
    }
  },
  "required": [
    "report_id",
    "run_id",
    "dataset_version_id",
    "contract_version_id",
    "generator",
    "execution_status",
    "gate_status",
    "coverage",
    "dimensions",
    "issue_summary",
    "generated_at",
    "scoring",
    "radar"
  ],
  "title": "QualityReportV1_1",
  "type": "object"
}
