      },
      "required": [
        "implementation",
        "execution",
        "effective_scoring",
        "observational"
      ],
      "title": "ReportCoverageAnalysis",
      "type": "object"
    },
    "ReportDimension": {
      "additionalProperties": false,
      "properties": {
        "evaluated_metric_count": {
          "minimum": 0,
          "title": "Evaluated Metric Count",
          "type": "integer"
