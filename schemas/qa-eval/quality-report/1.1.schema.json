          "$ref": "#/$defs/ReportRatio"
        },
        "observational": {
          "$ref": "#/$defs/ReportRatio"
        },
        "task_execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportRatio"
            },
