{
  "$defs": {
    "EvaluatedRule": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                "LT",
                "LTE",
                "GT",
                "GTE",
                "EQ",
                "NE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "strategy": {
          "default": "THRESHOLD",
          "enum": [
            "THRESHOLD",
            "OBSERVE_ONLY"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "title": "EvaluatedRule",
      "type": "object"
    },
    "NativeEvaluationReportSection": {
      "additionalProperties": false,
      "properties": {
        "affected_record_count": {
          "minimum": 0,
          "title": "Affected Record Count",
          "type": "integer"
        },
        "evaluation": {
          "$ref": "#/$defs/NativeRuleEvaluationV1"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "issue_count": {
          "minimum": 0,
          "title": "Issue Count",
          "type": "integer"
        }
      },
      "required": [
        "evaluation",
        "affected_record_count",
        "issue_count",
        "evidence_count"
      ],
      "title": "NativeEvaluationReportSection",
      "type": "object"
    },
    "NativeRuleEvaluationV1": {
      "additionalProperties": false,
      "properties": {
        "calculator": {
          "$ref": "#/$defs/VersionedKey"
        },
        "calculator_result_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculator Result Id"
        },
        "contract_version_id": {
          "format": "uuid",
          "title": "Contract Version Id",
          "type": "string"
        },
        "dataset_version_id": {
          "format": "uuid",
          "title": "Dataset Version Id",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/VersionedKey"
        },
        "metric_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Value"
        },
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/EvaluatedRule"
        },
        "rule_evaluation_id": {
          "format": "uuid",
          "title": "Rule Evaluation Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "statistic": {
          "$ref": "#/$defs/StatisticDefinition"
        },
        "statistic_ref": {
          "$ref": "#/$defs/NativeStatisticRef"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "rule_evaluation_id",
        "run_id",
        "dataset_version_id",
        "contract_version_id",
        "calculator_result_id",
        "calculator",
        "metric",
        "statistic_ref",
        "statistic",
        "severity",
        "rule",
        "status",
        "reason_code",
        "evaluated_at"
      ],
      "title": "NativeRuleEvaluationV1",
      "type": "object"
    },
    "NativeStatisticRef": {
      "additionalProperties": false,
      "properties": {
        "calculator_version": {
          "minLength": 1,
          "title": "Calculator Version",
          "type": "string"
        },
        "contract_item_key": {
          "minLength": 1,
          "title": "Contract Item Key",
          "type": "string"
        },
        "output_slot_id": {
          "minLength": 1,
          "title": "Output Slot Id",
          "type": "string"
        },
        "statistics_key": {
          "minLength": 1,
          "title": "Statistics Key",
          "type": "string"
        }
      },
      "required": [
        "contract_item_key",
        "output_slot_id",
        "calculator_version",
        "statistics_key"
      ],
      "title": "NativeStatisticRef",
      "type": "object"
    },
    "ReportCoverage": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "minimum": 0,
          "title": "Error",
          "type": "integer"
        },
        "evaluated": {
          "minimum": 0,
          "title": "Evaluated",
          "type": "integer"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "not_applicable": {
          "minimum": 0,
          "title": "Not Applicable",
          "type": "integer"
        },
        "not_evaluated": {
          "minimum": 0,
          "title": "Not Evaluated",
          "type": "integer"
        },
        "partial": {
          "default": 0,
          "minimum": 0,
          "title": "Partial",
          "type": "integer"
        }
      },
      "required": [
        "evaluated",
        "not_applicable",
        "missing",
        "error",
        "not_evaluated"
      ],
      "title": "ReportCoverage",
      "type": "object"
