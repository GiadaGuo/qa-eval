    "ReportDimensionScore": {
      "additionalProperties": false,
      "properties": {
        "applicable_weight": {
          "minimum": 0,
          "title": "Applicable Weight",
          "type": "number"
        },
        "coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "dimension": {
          "pattern": "^020[1-8]$",
          "title": "Dimension",
          "type": "string"
        },
        "effective_weight": {
          "minimum": 0,
          "title": "Effective Weight",
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "effective_weight",
        "applicable_weight",
        "status"
      ],
      "title": "ReportDimensionScore",
      "type": "object"
    },
