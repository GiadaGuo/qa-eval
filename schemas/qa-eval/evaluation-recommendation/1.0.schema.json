{
  "$defs": {
    "ApplicabilityDecisionV1": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/ApplicabilityFindingV1"
          },
          "title": "Findings",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "NEEDS_INPUT",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ApplicabilityDecisionV1",
      "type": "object"
    },
    "ApplicabilityFindingV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApplicabilityFindingV1",
      "type": "object"
    },
    "EvaluationProposalItemV1": {
      "additionalProperties": false,
      "properties": {
        "available_content_roles": {
          "items": {
            "type": "string"
          },
          "title": "Available Content Roles",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ProposalCalculatorRef"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "dataset_binding": {
          "additionalProperties": true,
          "title": "Dataset Binding",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "execution_mode": {
          "default": "DIRECT",
          "enum": [
            "DIRECT",
            "SHARED_INFERENCE"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "measurement_definition": {
          "additionalProperties": true,
          "title": "Measurement Definition",
          "type": "object"
        },
        "metric": {
          "$ref": "#/$defs/ProposalMetricRef"
        },
        "parameter_schema": {
          "additionalProperties": true,
          "title": "Parameter Schema",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "rule": {
          "$ref": "#/$defs/ProposalRuleV1"
        },
        "selected_calculator": {
          "$ref": "#/$defs/ProposalCalculatorRef"
        },
        "semantic_coverage": {
          "additionalProperties": true,
          "title": "Semantic Coverage",
          "type": "object"
        }
      },
      "required": [
        "key",
        "metric",
        "candidates",
        "selected_calculator",
        "rule"
      ],
      "title": "EvaluationProposalItemV1",
      "type": "object"
    },
    "EvaluationProposalV1": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "enum": [
            "USER",
            "SYSTEM",
            "AGENT"
          ],
          "title": "Created By",
          "type": "string"
        },
        "dataset_version_id": {
          "format": "uuid",
          "title": "Dataset Version Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/EvaluationProposalItemV1"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "profile_fingerprint": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Fingerprint"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "revision",
        "dataset_version_id",
        "created_by",
        "items",
        "created_at"
      ],
      "title": "EvaluationProposalV1",
      "type": "object"
    },
    "EvaluationProposalValidationV1": {
      "additionalProperties": false,
      "properties": {
        "current_profile_fingerprint": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Profile Fingerprint"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ApplicabilityFindingV1"
          },
          "title": "Findings",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ProposalItemValidationV1"
          },
          "title": "Items",
          "type": "array"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "proposal_id",
        "revision",
        "valid",
        "items"
      ],
      "title": "EvaluationProposalValidationV1",
      "type": "object"
    },
    "GuideCoverageCandidateV1": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/ApplicabilityDecisionV1"
        },
        "calculator": {
          "$ref": "#/$defs/ProposalCalculatorRef"
        },
        "cost": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Cost",
          "type": "string"
        },
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        }
      },
      "required": [
        "calculator",
        "applicability",
        "deterministic",
        "cost"
      ],
      "title": "GuideCoverageCandidateV1",
      "type": "object"
    },
    "GuideCoverageItemV1": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/GuideCoverageCandidateV1"
          },
          "title": "Candidates",
          "type": "array"
        },
        "metric_key": {
          "minLength": 1,
          "title": "Metric Key",
          "type": "string"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "metric_version": {
          "minLength": 1,
          "title": "Metric Version",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "selected_calculator": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalCalculatorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "NEEDS_INPUT",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "metric_key",
        "metric_version",
        "metric_name",
        "status",
        "reason"
      ],
      "title": "GuideCoverageItemV1",
      "type": "object"
    },
    "MetricCalculatorBindingV1": {
      "additionalProperties": false,
      "properties": {
        "calculator_key": {
          "minLength": 1,
          "title": "Calculator Key",
          "type": "string"
        },
        "calculator_version": {
          "minLength": 1,
          "title": "Calculator Version",
          "type": "string"
        },
        "compatibility": {
          "additionalProperties": true,
          "title": "Compatibility",
          "type": "object"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "metric_key": {
          "minLength": 1,
          "title": "Metric Key",
          "type": "string"
        },
        "metric_version": {
          "minLength": 1,
          "title": "Metric Version",
          "type": "string"
        },
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "metric_key",
        "metric_version",
        "calculator_key",
        "calculator_version",
        "priority",
        "enabled"
      ],
      "title": "MetricCalculatorBindingV1",
      "type": "object"
    },
    "ProposalCalculatorRef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "title": "ProposalCalculatorRef",
      "type": "object"
    },
    "ProposalCandidateValidationV1": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/ApplicabilityDecisionV1"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricCalculatorBindingV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calculator": {
          "$ref": "#/$defs/ProposalCalculatorRef"
        }
      },
      "required": [
        "calculator",
        "applicability"
      ],
      "title": "ProposalCandidateValidationV1",
      "type": "object"
    },
    "ProposalItemValidationV1": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/ProposalCandidateValidationV1"
          },
          "title": "Candidates",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ApplicabilityFindingV1"
          },
          "title": "Findings",
          "type": "array"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "selected_applicability": {
          "$ref": "#/$defs/ApplicabilityDecisionV1"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "valid",
        "selected_applicability",
        "candidates"
      ],
      "title": "ProposalItemValidationV1",
      "type": "object"
    },
    "ProposalMetricRef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "measurement": {
          "minLength": 1,
          "title": "Measurement",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version",
        "measurement"
      ],
      "title": "ProposalMetricRef",
      "type": "object"
    },
    "ProposalRuleV1": {
      "additionalProperties": false,
      "properties": {
        "on_missing": {
          "enum": [
            "UNKNOWN",
            "SKIPPED"
          ],
          "title": "On Missing",
          "type": "string"
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                "LT",
                "LTE",
                "GT",
                "GTE",
                "EQ",
                "NE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "strategy": {
          "default": "THRESHOLD",
          "enum": [
            "THRESHOLD",
            "OBSERVE_ONLY"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "threshold": {
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "severity",
        "on_missing"
      ],
      "title": "ProposalRuleV1",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/evaluation-recommendation/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "guide_coverage": {
      "items": {
        "$ref": "#/$defs/GuideCoverageItemV1"
      },
      "title": "Guide Coverage",
      "type": "array"
    },
    "policy": {
      "const": "DEMO_POLICY_V1",
      "default": "DEMO_POLICY_V1",
      "title": "Policy",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationProposalV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationProposalValidationV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "guide_coverage"
  ],
  "title": "EvaluationRecommendationV1",
  "type": "object"
}
