{
  "$defs": {
    "ApplicabilityFindingV1": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "enum": [
                "EDIT_CALCULATOR_PARAMETERS",
                "EDIT_DATASET_BINDING",
                "EDIT_RULE",
                "CHECK_CALCULATOR"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "severity": {
          "default": "BLOCKING",
          "enum": [
            "BLOCKING",
            "WARNING"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApplicabilityFindingV1",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/applicability-decision/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/ApplicabilityFindingV1"
      },
      "title": "Findings",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE",
        "NEEDS_INPUT",
        "UNAVAILABLE"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "ApplicabilityDecisionV1",
  "type": "object"
}
