{
  "$id": "qa-eval://schemas/stage-run/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "calculator": {
      "additionalProperties": true,
      "title": "Calculator",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "input_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "output_artifacts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Output Artifacts",
      "type": "array"
    },
    "parameters_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parameters Fingerprint",
      "type": "string"
    },
    "physical_plan_id": {
      "format": "uuid",
      "title": "Physical Plan Id",
      "type": "string"
    },
    "resolved_parameters": {
      "additionalProperties": true,
      "title": "Resolved Parameters",
      "type": "object"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_id": {
      "minLength": 1,
      "title": "Stage Id",
      "type": "string"
    },
    "stage_run_id": {
      "format": "uuid",
      "title": "Stage Run Id",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "stats": {
      "additionalProperties": true,
      "title": "Stats",
      "type": "object"
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "stage_run_id",
    "run_id",
    "physical_plan_id",
    "stage_id",
    "attempt",
    "status",
    "calculator",
    "resolved_parameters",
    "parameters_fingerprint",
    "input_fingerprint"
  ],
  "title": "StageRunV1",
  "type": "object"
}
