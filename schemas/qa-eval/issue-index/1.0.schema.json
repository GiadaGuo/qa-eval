{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "checksum": {
          "$ref": "#/$defs/Checksum"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "enum": [
            "RAW_DATA",
            "DATASET_MANIFEST",
            "NORMALIZED_DATA",
            "REJECTED_RECORDS",
            "PROFILE",
            "STAGE_OUTPUT",
            "METRIC_EVIDENCE",
            "ISSUE_INDEX",
            "REPORT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        },
        "schema_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Ref"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "format",
        "media_type",
        "size_bytes",
        "checksum"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "IssueIndexSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "confirmed_count": {
          "minimum": 0,
          "title": "Confirmed Count",
          "type": "integer"
        }
      },
      "required": [
        "confirmed_count",
        "candidate_count"
      ],
      "title": "IssueIndexSummary",
      "type": "object"
    }
  },
  "$id": "qa-eval://schemas/issue-index/1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "issue_index_id": {
      "format": "uuid",
      "title": "Issue Index Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/IssueIndexSummary"
    },
    "supported_filters": {
      "items": {
        "enum": [
          "metric_key",
          "code",
          "determination",
          "severity",
          "scope",
          "sample_id"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Filters",
      "type": "array"
    }
  },
  "required": [
    "issue_index_id",
    "run_id",
    "dataset_version_id",
    "artifact",
    "supported_filters",
    "summary"
  ],
  "title": "IssueIndexV1",
  "type": "object"
}
