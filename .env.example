# PostgreSQL
POSTGRES_DB=qa_eval
POSTGRES_USER=qa_eval
POSTGRES_PASSWORD=change_me_local_only

# MinIO
MINIO_ROOT_USER=qa_eval_admin
MINIO_ROOT_PASSWORD=change_me_minio_local_only

# Host ports
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

QA_EVAL_DATABASE_URL=postgresql+psycopg://qa_eval:change_me_local_only@127.0.0.1:5432/qa_eval
# Dedicated PostgreSQL database for automated tests
QA_EVAL_TEST_DATABASE_URL=postgresql+psycopg://qa_eval:change_me_local_only@127.0.0.1:5432/qa_eval_test
QA_EVAL_AGENT_TOOL_TIMEOUT_SECONDS=10
QA_EVAL_AGENT_MAX_TOOL_CALLS_PER_TURN=4
# Dataset Version 质量评测 Agent：启用后由模型解释真实 Tool/Proposal 结果。
# API Key 仅由后端读取，禁止使用 VITE_ 前缀。
QA_EVAL_AGENT_LLM_ENABLED=false
QA_EVAL_LLM_BASE_URL=https://api.openai.com/v1
QA_EVAL_LLM_API_KEY=
QA_EVAL_LLM_MODEL=
QA_EVAL_LLM_TEMPERATURE=0.1
QA_EVAL_LLM_TIMEOUT_SECONDS=60
QA_EVAL_LLM_TRANSPORT_RETRIES=1
QA_EVAL_LLM_MAX_OUTPUT_TOKENS=4096
# 推理模型思考模式：留空用模型默认；"disabled" 关闭思考（需配合
# QA_EVAL_LLM_TEMPERATURE=0.6）。kimi-k2.6 等推理模型在思考模式下会把
# max_tokens 全部消耗在 reasoning_content 上导致 content 为空，说明文档评测
# 会因此「一直评测中/无结果」，需关闭思考。
QA_EVAL_LLM_THINKING=
