# QA Eval local single-machine defaults. No Docker service is required.
QA_EVAL_DATABASE_URL=sqlite:///data/runtime/qa-eval.sqlite3
QA_EVAL_TEST_DATABASE_URL=sqlite:///data/runtime/qa-eval-test.sqlite3
QA_EVAL_ARTIFACT_STORE_TYPE=local
QA_EVAL_ARTIFACT_STORE_LOCAL_ROOT=data/artifacts

QA_EVAL_AGENT_TOOL_TIMEOUT_SECONDS=10
QA_EVAL_AGENT_MAX_TOOL_CALLS_PER_TURN=4
QA_EVAL_AGENT_LLM_ENABLED=false

# Optional: OpenAI-compatible gateway for document evaluation/shared inference.
QA_EVAL_LLM_BASE_URL=
QA_EVAL_LLM_API_KEY=
QA_EVAL_LLM_MODEL=
QA_EVAL_LLM_TEMPERATURE=0.1
QA_EVAL_LLM_TIMEOUT_SECONDS=60
QA_EVAL_LLM_TRANSPORT_RETRIES=1
QA_EVAL_LLM_RETRY_BASE_DELAY_SECONDS=0.5
QA_EVAL_LLM_RETRY_MAX_DELAY_SECONDS=5
QA_EVAL_LLM_RETRY_TOTAL_BUDGET_SECONDS=130
QA_EVAL_LLM_MAX_OUTPUT_TOKENS=4096
QA_EVAL_LLM_THINKING=

# Optional: 02080101 text perplexity model.
QA_EVAL_KENLM_MODEL_PATH=

# Optional: read-only external MySQL datasource.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_TABLE=

# Optional: S3-compatible ArtifactStore. Change TYPE to s3 when enabled.
# QA_EVAL_ARTIFACT_STORE_TYPE=s3
# QA_EVAL_ARTIFACT_STORE_S3_BUCKET=
# QA_EVAL_ARTIFACT_STORE_S3_PREFIX=qa-eval
# QA_EVAL_ARTIFACT_STORE_S3_ENDPOINT_URL=
# QA_EVAL_ARTIFACT_STORE_S3_REGION_NAME=
# QA_EVAL_ARTIFACT_STORE_S3_ACCESS_KEY_ID=
# QA_EVAL_ARTIFACT_STORE_S3_SECRET_ACCESS_KEY=

# Optional legacy PostgreSQL connection (not needed for local mode):
# QA_EVAL_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/qa_eval
