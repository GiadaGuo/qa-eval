# ============================================================================
# qa-eval 服务器部署环境配置（deploy/server/.env）
# 复制为 .env 后按服务器实际情况修改；.env 不入库、不进镜像。
# ============================================================================

# ---- 必填：持久化数据根目录（宿主机绝对路径，必须在本机磁盘，不能是 NFS——
#      SQLite WAL 在 NFS 上会损坏）。目录结构见 README「数据迁移」。
QA_EVAL_DATA_DIR=/data/slx/projects/qa-eval-data

# ---- 必填：容器运行用户（与宿主机挂载目录属主兼容）。
#      在服务器上执行 `id -u` / `id -g` 填入（普通用户一般是 1000/1000），
#      并确保 $QA_EVAL_DATA_DIR 下 runtime/ artifacts/ 归该 uid 所有。
QA_EVAL_UID=1000
QA_EVAL_GID=1000

# ---- 对外发布地址：默认全网卡 0.0.0.0:5173（唯一发布端口）。
#      如需仅限某网卡/回环，改为对应 IP，例如 10.0.0.5 或 127.0.0.1。
QA_EVAL_WEB_BIND=0.0.0.0

# ---- Alembic 迁移策略：
#      if-missing  只有数据库文件不存在（全新部署）时才自动 upgrade head（默认）
#      always      每次启动都 upgrade —— 只在完成备份后手动启用
#      never       从不迁移
QA_EVAL_RUN_MIGRATIONS=if-missing

TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 以下全部可选：不配置（留空）即禁用对应功能，平台照常运行。
# ---------------------------------------------------------------------------

# OpenAI 兼容 LLM 网关（说明文档评测 / Agent 对话 / 语义裁决用）。
# 服务器必须能访问该地址才配置；例如内网网关：
# QA_EVAL_LLM_BASE_URL=http://100.100.30.97:9998/v1
QA_EVAL_LLM_BASE_URL=
QA_EVAL_LLM_API_KEY=
QA_EVAL_LLM_MODEL=
QA_EVAL_LLM_TEMPERATURE=0.1
QA_EVAL_LLM_TIMEOUT_SECONDS=300
# 推理模型的思考模式开关（如 kimi-k2.6 需 disabled，见项目 .env.example 注释）
QA_EVAL_LLM_THINKING=
QA_EVAL_LLM_MAX_OUTPUT_TOKENS=4096
QA_EVAL_DOCUMENT_MAX_PROMPT_LINES=4000
QA_EVAL_AGENT_LLM_ENABLED=false
QA_EVAL_AGENT_TOOL_TIMEOUT_SECONDS=10
QA_EVAL_AGENT_MAX_TOOL_CALLS_PER_TURN=4

# KenLM 文本困惑度模型（02080101）。镜像未内置 kenlm（需 C++ 编译），
# 留空则该 Calculator 在 Registry 中标记为不可执行，其余功能不受影响。
QA_EVAL_KENLM_MODEL_PATH=

# 只读外部 MySQL 数据源（数据集导入用）。服务器可达才配置。
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_TABLE=
